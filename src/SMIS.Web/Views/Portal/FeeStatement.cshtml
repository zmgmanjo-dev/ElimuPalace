@model List<SMIS.Domain.Entities.Finance.StudentInvoice>
@{
    Layout = "_PortalLayout";
    ViewData["Title"] = "Fee Statement";
    var student = ViewBag.Student as SMIS.Domain.Entities.Students.Student;
}

@await Html.PartialAsync("_ChildSelector")

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold mb-0">Fee Statement — @student!.FullName</h4>
    <div class="d-flex gap-2">
        <a href="/Portal/FeeStatementPdf?studentId=@student.Id&download=false"
           target="_blank" class="btn btn-outline-primary btn-sm">
            <i class="fas fa-eye me-1"></i> Preview
        </a>
        <a href="/Portal/FeeStatementPdf?studentId=@student.Id&download=true"
           class="btn btn-danger btn-sm">
            <i class="fas fa-file-pdf me-1"></i> Download
        </a>
        <a href="/Portal/Dashboard?studentId=@student.Id" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center">
                <div class="text-muted small">Total Invoiced</div>
                <div class="fs-4 fw-bold text-primary">
                    KES @(((decimal)ViewBag.TotalInvoiced).ToString("N0"))
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center">
                <div class="text-muted small">Total Paid</div>
                <div class="fs-4 fw-bold text-success">
                    KES @(((decimal)ViewBag.TotalPaid).ToString("N0"))
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card @(((decimal)ViewBag.TotalBalance) > 0 ? "border-danger" : "border-success")">
            <div class="card-body text-center">
                <div class="text-muted small">Balance</div>
                <div class="fs-4 fw-bold @(((decimal)ViewBag.TotalBalance) > 0 ? "text-danger" : "text-success")">
                    KES @(((decimal)ViewBag.TotalBalance).ToString("N0"))
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <i class="fas fa-receipt me-2 text-primary"></i>
        <strong>Statement Ledger</strong>
        <span class="text-muted small ms-2">Chronological record with running balance</span>
    </div>
    @{
        var ledger = ViewBag.Ledger as List<dynamic>;
    }
    @if (ledger == null || !ledger.Any())
    {
        <div class="card-body text-center py-4">
            <p class="text-muted mb-0">No transactions recorded yet.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Description</th>
                        <th>Term</th>
                        <th class="text-end">Invoiced (KES)</th>
                        <th class="text-end">Paid (KES)</th>
                        <th class="text-end">Balance (KES)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in ledger)
                    {
                        <tr>
                            <td>@(((DateTime)l.Date).ToString("dd MMM yyyy"))</td>
                            <td>@l.Description</td>
                            <td class="text-muted small">@l.Term</td>
                            <td class="text-end">
                                @(((decimal)l.Debit) > 0 ? ((decimal)l.Debit).ToString("N0") : "-")
                            </td>
                            <td class="text-end text-success">
                                @(((decimal)l.Credit) > 0 ? ((decimal)l.Credit).ToString("N0") : "-")
                            </td>
                            <td class="text-end fw-bold @(((decimal)l.Balance) > 0 ? "text-danger" : "text-success")">
                                @(((decimal)l.Balance).ToString("N0"))
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>