@model List<SMIS.Domain.Entities.Academic.AttendanceRecord>
@{
    Layout = "_PortalLayout";
    ViewData["Title"] = "Attendance";
    var student = ViewBag.Student as SMIS.Domain.Entities.Students.Student;
}

@await Html.PartialAsync("_ChildSelector")

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold mb-0">Attendance — @student!.FullName</h4>
    <div class="d-flex gap-2">
        <a href="/Portal/AttendancePdf?studentId=@student.Id&termId=@ViewBag.SelectedTermId&download=false"
           target="_blank" class="btn btn-outline-primary btn-sm">
            <i class="fas fa-eye me-1"></i> Preview
        </a>
        <a href="/Portal/AttendancePdf?studentId=@student.Id&termId=@ViewBag.SelectedTermId&download=true"
           class="btn btn-danger btn-sm">
            <i class="fas fa-file-pdf me-1"></i> Download
        </a>
        <a href="/Portal/Dashboard?studentId=@student.Id" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-end">
            <input type="hidden" name="studentId" value="@student.Id" />
            <div class="col-md-4">
                <label class="form-label small fw-bold">Term</label>
                <select name="termId" class="form-control" onchange="this.form.submit()">
                    @foreach (var term in ViewBag.Terms)
                    {
                        if (ViewBag.SelectedTermId != null && ViewBag.SelectedTermId == term.Id)
                        {
                            <option value="@term.Id" selected>@term.AcademicYear.Name — @term.Name</option>
                        }
                        else
                        {
                            <option value="@term.Id">@term.AcademicYear.Name — @term.Name</option>
                        }
                    }
                </select>
            </div>
        </form>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card">
            <div class="card-body text-center">
                <div class="fs-4 fw-bold text-success">@ViewBag.Present</div>
                <div class="text-muted small">Present</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card">
            <div class="card-body text-center">
                <div class="fs-4 fw-bold text-danger">@ViewBag.Absent</div>
                <div class="text-muted small">Absent</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card">
            <div class="card-body text-center">
                <div class="fs-4 fw-bold text-warning">@ViewBag.Late</div>
                <div class="text-muted small">Late</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card">
            <div class="card-body text-center">
                <div class="fs-4 fw-bold text-info">@ViewBag.Excused</div>
                <div class="text-muted small">Excused</div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <strong>Daily Record</strong>
        <span class="badge bg-primary ms-2">@Model.Count</span>
    </div>
    @if (!Model.Any())
    {
        <div class="card-body text-center py-4">
            <p class="text-muted mb-0">No attendance records for this term yet.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td>@r.AttendanceDate.ToString("dd MMM yyyy (ddd)")</td>
                            <td>
                                @switch (r.Status)
                                {
                                    case SMIS.Domain.Entities.Academic.AttendanceStatus.Present:
                                        <span class="badge bg-success">Present</span>
                                        break;
                                    case SMIS.Domain.Entities.Academic.AttendanceStatus.Absent:
                                        <span class="badge bg-danger">Absent</span>
                                        break;
                                    case SMIS.Domain.Entities.Academic.AttendanceStatus.Late:
                                        <span class="badge bg-warning text-dark">Late</span>
                                        break;
                                    case SMIS.Domain.Entities.Academic.AttendanceStatus.Excused:
                                        <span class="badge bg-info text-dark">Excused</span>
                                        break;
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>