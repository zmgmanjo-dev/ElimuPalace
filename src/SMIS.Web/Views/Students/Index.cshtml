@model List<SMIS.Domain.Entities.Students.Student>
@using SMIS.Domain.Enums
@{
    ViewData["Title"] = "Students";
}

<div class="app-wrapper">
    @await Html.PartialAsync("_Sidebar")
        

    <div class="main-content">
        <header class="top-header">
            <div class="header-left">
                <span class="page-title">
                    <i class="fas fa-user-graduate me-2 text-primary"></i>Students
                </span>
            </div>
            <div class="header-right">
                <a href="/Students/Create" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus me-1"></i> Admit Student
                </a>
                <div class="user-avatar ms-2">
                    @(User.Identity?.Name?.Substring(0,1).ToUpper() ?? "A")
                </div>
                <form asp-action="Logout" asp-controller="Account" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="header-btn" title="Logout">
                        <i class="fas fa-sign-out-alt"></i>
                    </button>
                </form>
            </div>
        </header>

        <div class="content-area">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-4">
                    <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @* Summary Cards *@
            <div class="row g-3 mb-4">
                <div class="col-sm-6 col-xl-3">
                    <div class="stat-card">
                        <div class="stat-icon blue">
                            <i class="fas fa-users"></i>
                        </div>
                        <div>
                            <div class="stat-value">@Model.Count</div>
                            <div class="stat-label">Total Students</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="stat-card">
                        <div class="stat-icon blue">
                            <i class="fas fa-male"></i>
                        </div>
                        <div>
                            <div class="stat-value">@Model.Count(s => s.Gender == Gender.Male)</div>
                            <div class="stat-label">Boys</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="stat-card">
                        <div class="stat-icon purple">
                            <i class="fas fa-female"></i>
                        </div>
                        <div>
                            <div class="stat-value">@Model.Count(s => s.Gender == Gender.Female)</div>
                            <div class="stat-label">Girls</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="stat-card">
                        <div class="stat-icon green">
                            <i class="fas fa-user-check"></i>
                        </div>
                        <div>
                            <div class="stat-value">@Model.Count(s => s.Status == StudentStatus.Active)</div>
                            <div class="stat-label">Active</div>
                        </div>
                    </div>
                </div>
            </div>

            @* Search and Filter *@
<div class="card mb-4">
    <div class="card-body p-3">
        <form method="get" action="/Students" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-bold">Search Student</label>
                <div class="input-group">
                    <span class="input-group-text bg-white">
                        <i class="fas fa-search text-muted"></i>
                    </span>
                    <input type="text" name="search" class="form-control"
                           placeholder="Name or Admission Number..."
                           value="@ViewBag.Search" />
                </div>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold">Class</label>
                <select name="classId" class="form-control">
                    <option value="">All Classes</option>
                    @foreach (var cls in ViewBag.Classes)
                    {
                        <option value="@cls.Id"
                                selected="@(ViewBag.ClassId != null && ViewBag.ClassId == cls.Id ? "selected" : null)">
                            @cls.Name
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold">Stream</label>
                <select name="streamId" class="form-control">
                    <option value="">All Streams</option>
                    @foreach (var stream in ViewBag.Streams)
                    {
                        <option value="@stream.Id"
                                selected="@(ViewBag.StreamId != null && ViewBag.StreamId == stream.Id ? "selected" : null)">
                            @stream.ClassLevel.Name — @stream.Name
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold">Gender</label>
                <select name="gender" class="form-control">
                    <option value="">All</option>
                    <option value="Male" selected="@(ViewBag.Gender != null && ViewBag.Gender.ToString() == "Male" ? "selected" : null)">Male</option>
                    <option value="Female" selected="@(ViewBag.Gender != null && ViewBag.Gender.ToString() == "Female" ? "selected" : null)">Female</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold">Status</label>
                <select name="status" class="form-control">
                    <option value="">All</option>
                    @foreach (var s in Enum.GetValues(typeof(StudentStatus)))
                    {
                        <option value="@s"
                                selected="@(ViewBag.Status != null && ViewBag.Status.ToString() == s.ToString() ? "selected" : null)">
                            @s
                        </option>
                    }
                </select>
            </div>
            <div class="col-12 d-flex gap-2 mt-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-search me-1"></i> Search
                </button>
                <a href="/Students" class="btn btn-outline-secondary">
                    <i class="fas fa-times me-1"></i> Clear Filters
                </a>
            </div>
        </form>
    </div>
</div>

            @* Students Table *@
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>
                        <i class="fas fa-list me-2 text-primary"></i>
                        Student List
                        <span class="badge bg-primary ms-2">@Model.Count</span>
                    </span>
                </div>
                @if (!Model.Any())
                {
                    <div class="card-body text-center py-5">
                        <i class="fas fa-user-graduate fa-3x text-muted mb-3"></i>
                        <h5 class="text-muted">No Students Yet</h5>
                        <p class="text-muted">Click "Admit Student" to register the first student.</p>
                        <a href="/Students/Create" class="btn btn-primary">
                            <i class="fas fa-plus me-1"></i> Admit First Student
                        </a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Photo</th>
                                    <th>Adm. No</th>
                                    <th>Full Name</th>
                                    <th>Class</th>
                                    <th>Stream</th>
                                    <th>Gender</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var student in Model)
                                {
                                    <tr>
                                        <td>
                                            @if (student.PhotoPath != null)
                                            {
                                                <img src="@student.PhotoPath"
                                                     style="width:36px;height:36px;border-radius:50%;object-fit:cover;" />
                                            }
                                            else
                                            {
                                                <div style="width:36px;height:36px;border-radius:50%;background:#e5e7eb;display:flex;align-items:center;justify-content:center;">
                                                    <i class="fas fa-user text-muted"></i>
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark fw-bold">
                                                @student.AdmissionNumber
                                            </span>
                                        </td>
                                        <td>
                                            <strong>@student.FullName</strong>
                                        </td>
                                        <td>@(student.ClassLevel?.Name ?? "-")</td>
                                        <td>@(student.ClassStream?.Name ?? "-")</td>
                                        <td>
                                            @if (student.Gender == Gender.Male)
                                            {
                                                <span class="badge bg-info text-dark">
                                                    <i class="fas fa-male me-1"></i>Male
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-pink" style="background:#f9a8d4;color:#831843;">
                                                    <i class="fas fa-female me-1"></i>Female
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            @if (student.Status == StudentStatus.Active)
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">@student.Status</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="d-flex gap-1">
                                                <a href="/Students/Details/@student.Id"
                                                   class="btn btn-sm btn-outline-primary"
                                                   title="View Profile">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a href="/Students/Edit/@student.Id"
                                                   class="btn btn-sm btn-outline-secondary"
                                                   title="Edit">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a href="/Students/ChangeStatus/@student.Id"
                                                   class="btn btn-sm btn-outline-danger"
                                                   title="Change Status">
                                                    <i class="fas fa-user-slash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>