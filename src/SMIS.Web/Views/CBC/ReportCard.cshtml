@using SMIS.Domain.Enums
@using SMIS.Domain.Entities.Academic
@{
    ViewData["Title"] = "CBC Report Card";
    var student = ViewBag.Student as SMIS.Domain.Entities.Students.Student;
    var selectedTerm = ViewBag.SelectedTerm as SMIS.Domain.Entities.School.AcademicTerm;
    var assessments = ViewBag.Assessments as List<CBCAssessment>
        ?? new List<CBCAssessment>();
    var reportCard = ViewBag.ReportCard as CBCReportCard;
    var school = ViewBag.School as SMIS.Domain.Entities.School.SchoolProfile;
    var daysPresent = (int)ViewBag.DaysPresent;
    var daysAbsent = (int)ViewBag.DaysAbsent;
}

<div class="app-wrapper">
    @await Html.PartialAsync("_Sidebar")
        
    <div class="main-content">
        <header class="top-header">
            <div class="header-left">
                <span class="page-title">
                    <i class="fas fa-file-alt me-2 text-primary"></i>
                    CBC Report Card — @student?.FullName
                </span>
            </div>
            <div class="header-right">
                <a href="/CBC/DownloadReportCard?studentId=@student?.Id&termId=@selectedTerm?.Id"
                   class="btn btn-success btn-sm me-2" target="_blank">
                    <i class="fas fa-download me-1"></i> Download PDF
                </a>
                <button onclick="window.print()"
                        class="btn btn-outline-primary btn-sm me-2">
                    <i class="fas fa-print me-1"></i> Print
                </button>
                <a href="/CBC" class="btn btn-outline-secondary btn-sm me-2">
                    <i class="fas fa-arrow-left me-1"></i> Back
                </a>
                <div class="user-avatar ms-2">
                    @(User.Identity?.Name?.Substring(0,1).ToUpper() ?? "A")
                </div>
                <form asp-action="Logout" asp-controller="Account"
                      method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="header-btn" title="Logout">
                        <i class="fas fa-sign-out-alt"></i>
                    </button>
                </form>
            </div>
        </header>

        <div class="content-area">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-4">
                    <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close"
                            data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="card mb-4">
                <div class="card-body p-3">
                    <div class="row g-2">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Select Term</label>
                            <select class="form-control"
                                    onchange="window.location='/CBC/ReportCard?studentId=@student?.Id&termId='+this.value">
                                @foreach (var term in ViewBag.Terms)
                                {
                                    if (selectedTerm?.Id == term.Id)
                                    {
                                        <option value="@term.Id" selected>
                                            @term.AcademicYear.Name - @term.Name
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@term.Id">
                                            @term.AcademicYear.Name - @term.Name
                                        </option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-md-8">
                    <div class="card mb-4">
                        <div class="card-body p-4 text-center">
                            <h4 class="fw-bold text-primary">
                                @(school?.Name ?? "SMIS School")
                            </h4>
                            <p class="text-muted mb-1">
                                @(school?.Motto ?? "Excellence Through Knowledge")
                            </p>
                            <h5 class="fw-bold mt-2">CBC PROGRESS REPORT</h5>
                            <p class="text-muted mb-0">
                                @selectedTerm?.AcademicYear?.Name —
                                @selectedTerm?.Name
                            </p>
                        </div>
                    </div>

                    <div class="card mb-4">
                        <div class="card-body p-4">
                            <div class="row">
                                <div class="col-md-6">
                                    <table class="table table-sm mb-0">
                                        <tr>
                                            <td class="fw-bold text-muted">Name:</td>
                                            <td><strong>@student?.FullName</strong></td>
                                        </tr>
                                        <tr>
                                            <td class="fw-bold text-muted">Adm No:</td>
                                            <td>@student?.AdmissionNumber</td>
                                        </tr>
                                        <tr>
                                            <td class="fw-bold text-muted">Class:</td>
                                            <td>@student?.ClassLevel?.Name</td>
                                        </tr>
                                        <tr>
                                            <td class="fw-bold text-muted">Stream:</td>
                                            <td>@(student?.ClassStream?.Name ?? "-")</td>
                                        </tr>
                                    </table>
                                </div>
                                <div class="col-md-6">
                                    <table class="table table-sm mb-0">
                                        <tr>
                                            <td class="fw-bold text-muted">Days Present:</td>
                                            <td class="text-success fw-bold">
                                                @daysPresent
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="fw-bold text-muted">Days Absent:</td>
                                            <td class="text-danger fw-bold">
                                                @daysAbsent
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="fw-bold text-muted">Total Days:</td>
                                            <td>@(daysPresent + daysAbsent)</td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card mb-4">
                        <div class="card-header">
                            <i class="fas fa-chart-bar me-2 text-primary"></i>
                            <strong>Learning Areas Assessment</strong>
                        </div>
                        @if (!assessments.Any())
                        {
                            <div class="card-body text-center py-4">
                                <p class="text-muted">
                                    No assessments recorded for this term yet.
                                </p>
                                <a href="/CBC/EnterAssessment?classLevelId=@student?.ClassLevelId"
                                   class="btn btn-primary btn-sm">
                                    Enter Assessment
                                </a>
                            </div>
                        }
                        else
                        {
                            <table class="table mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Learning Area</th>
                                        <th class="text-center">Performance</th>
                                        <th class="text-center">Score</th>
                                        <th>Teacher's Remarks</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var assessment in assessments)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@assessment.Subject.Name</strong>
                                            </td>
                                            <td class="text-center">
                                                @switch (assessment.PerformanceLevel)
                                                {
                                                    case PerformanceLevel.BelowExpectation:
                                                        <span class="badge bg-danger px-3 py-2">BE</span>
                                                        break;
                                                    case PerformanceLevel.ApproachingExpectation:
                                                        <span class="badge bg-warning text-dark px-3 py-2">AE</span>
                                                        break;
                                                    case PerformanceLevel.MeetExpectation:
                                                        <span class="badge bg-success px-3 py-2">ME</span>
                                                        break;
                                                    case PerformanceLevel.ExceedsExpectation:
                                                        <span class="badge bg-primary px-3 py-2">EE</span>
                                                        break;
                                                }
                                            </td>
                                            <td class="text-center">
                                                @(assessment.Score.HasValue
                                                    ? $"{assessment.Score}/100" : "-")
                                            </td>
                                            <td class="text-muted small">
                                                @(assessment.TeacherRemarks ?? "-")
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>

                    <div class="card mb-4">
                        <div class="card-body p-3">
                            <strong class="small text-muted">PERFORMANCE KEY:</strong>
                            <span class="badge bg-danger ms-2">BE</span>
                            <small class="me-3">Below Expectation</small>
                            <span class="badge bg-warning text-dark">AE</span>
                            <small class="me-3">Approaching Expectation</small>
                            <span class="badge bg-success">ME</span>
                            <small class="me-3">Meets Expectation</small>
                            <span class="badge bg-primary">EE</span>
                            <small>Exceeds Expectation</small>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card">
                        <div class="card-header">
                            <i class="fas fa-edit me-2 text-primary"></i>
                            <strong>Teacher's Report</strong>
                        </div>
                        <div class="card-body p-4">
                            <form asp-action="SaveReportCard"
                                  asp-controller="CBC" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="studentId"
                                       value="@student?.Id" />
                                <input type="hidden" name="academicTermId"
                                       value="@selectedTerm?.Id" />
                                <input type="hidden" name="academicYearId"
                                       value="@selectedTerm?.AcademicYearId" />
                                <input type="hidden" name="classLevelId"
                                       value="@student?.ClassLevelId" />

                                <div class="mb-3">
                                    <label class="form-label fw-bold small">
                                        Class Teacher's Remarks
                                    </label>
                                    <select class="form-control form-control-sm mb-1"
                                            onchange="setRemark('classTeacherRemarks', this.value)">
                                        <option value="">
                                            -- Select preset remark --
                                        </option>
                                        @foreach (var remark in SMIS.Web.Helpers.RemarksHelper.ClassTeacherRemarks)
                                        {
                                            <option value="@remark">
                                                @(remark.Length > 50 ? remark.Substring(0, 50) + "..." : remark)
                                            </option>
                                        }
                                    </select>
                                    <textarea name="classTeacherRemarks"
                                              id="classTeacherRemarks"
                                              class="form-control" rows="3"
                                              placeholder="Or type custom remark...">@(reportCard?.ClassTeacherRemarks ?? "")</textarea>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold small">
                                        Principal's Remarks
                                    </label>
                                    <select class="form-control form-control-sm mb-1"
                                            onchange="setRemark('principalRemarks', this.value)">
                                        <option value="">
                                            -- Select preset remark --
                                        </option>
                                        @foreach (var remark in SMIS.Web.Helpers.RemarksHelper.PrincipalRemarks)
                                        {
                                            <option value="@remark">
                                                @(remark.Length > 50 ? remark.Substring(0, 50) + "..." : remark)
                                            </option>
                                        }
                                    </select>
                                    <textarea name="principalRemarks"
                                              id="principalRemarks"
                                              class="form-control" rows="2"
                                              placeholder="Or type custom remark...">@(reportCard?.PrincipalRemarks ?? "")</textarea>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold small">
                                        Conduct
                                    </label>
                                    <select name="conduct" class="form-control">
                                        <option value="">-- Select --</option>
                                        <option>Excellent</option>
                                        <option>Very Good</option>
                                        <option>Good</option>
                                        <option>Fair</option>
                                        <option>Needs Improvement</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold small">
                                        Punctuality
                                    </label>
                                    <select name="punctuality" class="form-control">
                                        <option value="">-- Select --</option>
                                        <option>Excellent</option>
                                        <option>Good</option>
                                        <option>Fair</option>
                                        <option>Poor</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold small">
                                        Sports/Activities
                                    </label>
                                    <input type="text" name="sportActivities"
                                           class="form-control"
                                           placeholder="e.g. Football, Athletics"
                                           value="@(reportCard?.SportActivities ?? "")" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold small">
                                        Clubs
                                    </label>
                                    <input type="text" name="clubActivities"
                                           class="form-control"
                                           placeholder="e.g. Drama, Science Club"
                                           value="@(reportCard?.ClubActivities ?? "")" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold small">
                                        Next Term Begins
                                    </label>
                                    <input type="date" name="nextTermBegins"
                                           class="form-control"
                                           value="@(reportCard?.NextTermBegins?.ToString("yyyy-MM-dd") ?? "")" />
                                </div>
                                <div class="form-check mb-3">
                                    <input type="checkbox" name="isPromoted"
                                           value="true" class="form-check-input"
                                           id="isPromotedCheck"
                                           @(reportCard?.IsPromoted != false ? "checked" : "") />
                                    <label class="form-check-label"
                                           for="isPromotedCheck">
                                        Promoted to next class
                                    </label>
                                </div>
                                <button type="submit"
                                        class="btn btn-primary w-100">
                                    <i class="fas fa-save me-2"></i>
                                    Save Report Card
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function setRemark(fieldId, value) {
        if (value) {
            document.getElementById(fieldId).value = value;
        }
    }
</script>
}