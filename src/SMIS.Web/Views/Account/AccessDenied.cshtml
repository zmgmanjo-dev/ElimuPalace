@{
    ViewData["Title"] = "Access Denied";
}

<div class="login-wrapper">
    <div class="login-card text-center">
        <div class="login-logo">
            <i class="fas fa-lock"></i>
        </div>
        <h4 class="fw-bold text-danger mb-2">Access Denied</h4>
        <p class="text-muted mb-4">
            You don't have permission to view this page.
            If you believe this is a mistake, please contact your administrator.
        </p>
        @if (User.IsInRole("Parent") || User.IsInRole("Student"))
{
    <a href="/Portal/Dashboard" class="btn btn-primary w-100">
        <i class="fas fa-arrow-left me-2"></i>Back to Portal
    </a>
}
else
{
    <a href="/Dashboard" class="btn btn-primary w-100">
        <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
    </a>
}
    </div>
</div>