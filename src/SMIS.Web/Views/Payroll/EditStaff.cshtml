@model SMIS.Domain.Entities.Accounting.StaffPayroll
@using SMIS.Domain.Entities.Accounting
@{
    ViewData["Title"] = "Edit Staff";
}

<div class="app-wrapper">
    @await Html.PartialAsync("_Sidebar")

    <div class="main-content">
        <header class="top-header">
            <div class="header-left">
                <span class="page-title">
                    <i class="fas fa-user-edit me-2 text-primary"></i>
                    Edit Staff — @Model.FullName
                </span>
            </div>
            <div class="header-right">
                <a href="/Payroll/Staff" class="btn btn-outline-secondary btn-sm me-2">
                    <i class="fas fa-arrow-left me-1"></i> Back
                </a>
                <div class="user-avatar ms-2">
                    @(User.Identity?.Name?.Substring(0,1).ToUpper() ?? "A")
                </div>
                <form asp-action="Logout" asp-controller="Account" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="header-btn" title="Logout">
                        <i class="fas fa-sign-out-alt"></i>
                    </button>
                </form>
            </div>
        </header>

        <div class="content-area">
            <form asp-action="EditStaff" asp-controller="Payroll" method="post">
                @Html.AntiForgeryToken()
                <div class="card mb-4">
                    <div class="card-header">
                        <i class="fas fa-id-card me-2 text-primary"></i>Staff Details
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Full Name <span class="text-danger">*</span></label>
                                <input type="text" name="fullName" class="form-control" value="@Model.FullName" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Email Address</label>
                                <input type="email" name="email" class="form-control" value="@Model.Email" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Staff Type</label>
                                <select name="staffType" class="form-control"
                                        asp-items="Html.GetEnumSelectList<StaffPayrollType>()"
                                        asp-for="StaffType"></select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Employment Type</label>
                                <select name="employmentType" class="form-control"
                                        asp-items="Html.GetEnumSelectList<SMIS.Domain.Enums.EmploymentType>()"
                                        asp-for="EmploymentType"></select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">National ID</label>
                                <input type="text" name="nationalId" class="form-control" value="@Model.NationalId" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">KRA PIN</label>
                                <input type="text" name="kraPin" class="form-control" value="@Model.KRAPin" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">NSSF No.</label>
                                <input type="text" name="nssfNumber" class="form-control" value="@Model.NSSFNumber" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">SHA No.</label>
                                <input type="text" name="shaNumber" class="form-control" value="@Model.shaNumber" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Bank Name</label>
                                <input type="text" name="bankName" class="form-control" value="@Model.BankName" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Bank Account No.</label>
                                <input type="text" name="bankAccount" class="form-control" value="@Model.BankAccount" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header">
                        <i class="fas fa-money-bill-wave me-2 text-success"></i>Earnings
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-2">
                                <label class="form-label fw-bold">Basic Salary <span class="text-danger">*</span></label>
                                <input type="number" name="basicSalary" class="form-control" value="@Model.BasicSalary" min="0" step="0.01" required />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label fw-bold">House Allow.</label>
                                <input type="number" name="houseAllowance" class="form-control" value="@Model.HouseAllowance" min="0" step="0.01" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label fw-bold">Transport Allow.</label>
                                <input type="number" name="transportAllowance" class="form-control" value="@Model.TransportAllowance" min="0" step="0.01" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label fw-bold">Medical Allow.</label>
                                <input type="number" name="medicalAllowance" class="form-control" value="@Model.MedicalAllowance" min="0" step="0.01" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label fw-bold">Other Allowances</label>
                                <input type="number" name="otherAllowances" class="form-control" value="@Model.OtherAllowances" min="0" step="0.01" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header text-danger">
                        <i class="fas fa-minus-circle me-2"></i>Voluntary Deductions
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label fw-bold">SACCO Deduction</label>
                                <input type="number" name="saccoDeduction" class="form-control" value="@Model.SACCODeduction" min="0" step="0.01" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Loan Deduction</label>
                                <input type="number" name="loanDeduction" class="form-control" value="@Model.LoanDeduction" min="0" step="0.01" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Other Deductions</label>
                                <input type="number" name="otherDeductions" class="form-control" value="@Model.OtherDeductions" min="0" step="0.01" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 mb-4">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-save me-2"></i>Save Changes
                    </button>
                    <a href="/Payroll/Staff" class="btn btn-outline-secondary px-4">
                        <i class="fas fa-times me-2"></i>Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>