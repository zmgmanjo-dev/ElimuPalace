@model List<SMIS.Domain.Entities.Accounting.PayrollRun>
@using SMIS.Domain.Entities.Accounting
@{
    ViewData["Title"] = "Payroll Runs";
}

<div class="app-wrapper">
    @await Html.PartialAsync("_Sidebar")
        
    <div class="main-content">
        <header class="top-header">
            <div class="header-left">
                <span class="page-title">
                    <i class="fas fa-calendar-alt me-2 text-primary"></i>
                    Payroll Runs
                </span>
            </div>
            <div class="header-right">
                <button class="btn btn-primary btn-sm"
                        data-bs-toggle="modal"
                        data-bs-target="#generateModal">
                    <i class="fas fa-plus me-1"></i> Generate Payroll
                </button>
                <div class="user-avatar ms-2">
                    @(User.Identity?.Name?.Substring(0,1).ToUpper() ?? "A")
                </div>
                <form asp-action="Logout" asp-controller="Account"
                      method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="header-btn" title="Logout">
                        <i class="fas fa-sign-out-alt"></i>
                    </button>
                </form>
            </div>
        </header>

        <div class="content-area">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-4">
                    <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close"
                            data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mb-4">
                    <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close"
                            data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="card">
                <div class="card-header">
                    <strong>Payroll History</strong>
                    <span class="badge bg-primary ms-2">@Model.Count runs</span>
                </div>
                @if (!Model.Any())
                {
                    <div class="card-body text-center py-5">
                        <i class="fas fa-calendar-alt fa-3x text-muted mb-3"></i>
                        <h5 class="text-muted">No Payroll Runs Yet</h5>
                        <p class="text-muted">
                            Click <strong>"Generate Payroll"</strong>
                            to process monthly salaries.
                        </p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Run No.</th>
                                    <th>Period</th>
                                    <th>Staff</th>
                                    <th class="text-end">Gross</th>
                                    <th class="text-end">Deductions</th>
                                    <th class="text-end">Net Pay</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var run in Model)
                                {
                                    <tr>
                                        <td>
                                            <strong>@run.RunNumber</strong>
                                        </td>
                                        <td>@run.MonthName</td>
                                        <td>
                                            <span class="badge bg-info text-dark">
                                                @run.Lines.Count staff
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            KES @run.TotalGross.ToString("N0")
                                        </td>
                                        <td class="text-end text-danger">
                                            KES @run.TotalDeductions.ToString("N0")
                                        </td>
                                        <td class="text-end fw-bold text-success">
                                            KES @run.TotalNetPay.ToString("N0")
                                        </td>
                                        <td>
                                            @switch (run.Status)
                                            {
                                                case PayrollRunStatus.Approved:
                                                    <span class="badge bg-success">Approved</span>
                                                    break;
                                                case PayrollRunStatus.Draft:
                                                    <span class="badge bg-warning text-dark">Draft</span>
                                                    break;
                                                case PayrollRunStatus.Paid:
                                                    <span class="badge bg-primary">Paid</span>
                                                    break;
                                            }
                                        </td>
                                        <td>
                                            <a href="/Payroll/PayrollDetails/@run.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-eye"></i> View
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@* GENERATE PAYROLL MODAL *@
<div class="modal fade" id="generateModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-calculator me-2"></i>Generate Payroll
                </h5>
                <button type="button" class="btn-close"
                        data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="GeneratePayroll"
                  asp-controller="Payroll" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="alert alert-info small">
                        <i class="fas fa-info-circle me-1"></i>
                        This will calculate PAYE, NSSF and sha
                        automatically based on Kenya 2024 rates.
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Month</label>
                            <select name="month" class="form-control">
                                @for (int m = 1; m <= 12; m++)
                                {
                                    var mn = new DateTime(2024, m, 1).ToString("MMMM");
                                    if (m == DateTime.Today.Month)
                                    {
                                        <option value="@m" selected>@mn</option>
                                    }
                                    else
                                    {
                                        <option value="@m">@mn</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Year</label>
                            <input type="number" name="year"
                                   class="form-control"
                                   value="@DateTime.Today.Year" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-calculator me-1"></i>Generate
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>