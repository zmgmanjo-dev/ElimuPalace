@model List<SMIS.Domain.Entities.Students.Student>
@{
    ViewData["Title"] = "Class List";
    var selectedClass = ViewBag.SelectedClass as
        SMIS.Domain.Entities.School.ClassLevel;
    var school = ViewBag.School as
        SMIS.Domain.Entities.School.SchoolProfile;
}
<div class="app-wrapper">
    @await Html.PartialAsync("_Sidebar")
        
    <div class="main-content">
        <header class="top-header">
            <div class="header-left">
                <span class="page-title">
                    <i class="fas fa-list me-2 text-primary"></i>
                    Class List — @selectedClass?.Name
                </span>
            </div>
            <div class="header-right">
                <a href="/Reports/ClassListPdf?classId=@ViewBag.ClassId&download=false" target="_blank" class="btn btn-outline-primary btn-sm me-2">
    <i class="fas fa-eye me-1"></i> Preview
</a>
<a href="/Reports/ClassListPdf?classId=@ViewBag.ClassId&download=true" class="btn btn-danger btn-sm me-2">
    <i class="fas fa-file-pdf me-1"></i> Download
</a>
                <button onclick="window.print()"
                        class="btn btn-outline-primary btn-sm me-2">
                    <i class="fas fa-print me-1"></i> Print
                </button>
                <a href="/Reports/ExportStudentList?classId=@ViewBag.ClassId"
                   class="btn btn-outline-success btn-sm me-2">
                    <i class="fas fa-file-csv me-1"></i> Export CSV
                </a>
                <a href="/Reports" class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-arrow-left me-1"></i> Back
                </a>
                <div class="user-avatar ms-2">
                    @(User.Identity?.Name?.Substring(0,1).ToUpper() ?? "A")
                </div>
                <form asp-action="Logout" asp-controller="Account"
                      method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="header-btn" title="Logout">
                        <i class="fas fa-sign-out-alt"></i>
                    </button>
                </form>
            </div>
        </header>
        <div class="content-area">
            <div class="card mb-4">
                <div class="card-body p-3">
                    <div class="row g-2">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">
                                Select Class
                            </label>
                            <select class="form-control"
                                    onchange="window.location='/Reports/ClassList?classId='+this.value">
                                @foreach (var cls in ViewBag.Classes)
                                {
                                    if (ViewBag.ClassId != null &&
                                        ViewBag.ClassId == cls.Id)
                                    {
                                        <option value="@cls.Id" selected>
                                            @cls.Name
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@cls.Id">@cls.Name</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header text-center">
                    <h5 class="fw-bold mb-0">
                        @(school?.Name ?? "SMIS School")
                    </h5>
                    <p class="text-muted mb-0 small">
                        CLASS LIST — @selectedClass?.Name
                    </p>
                </div>
                <div class="table-responsive">
                    <table class="table table-bordered mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Adm No.</th>
                                <th>Full Name</th>
                                <th>Gender</th>
                                <th>Stream</th>
                                <th>Date of Birth</th>
                                <th>Parent Phone</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Count; i++)
                            {
                                var s = Model[i];
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td>@s.AdmissionNumber</td>
                                    <td><strong>@s.FullName</strong></td>
                                    <td>@s.Gender</td>
                                    <td>@(s.ClassStream?.Name ?? "-")</td>
                                    <td>@s.DateOfBirth.ToString("dd MMM yyyy")</td>
                                    <td>
                                        @(s.FatherPhone ?? s.MotherPhone ?? "-")
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="7" class="fw-bold">
                                    Total: @Model.Count students
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>