@{
    ViewData["Title"] = "CBC Performance Report";
}
<div class="app-wrapper">
    @await Html.PartialAsync("_Sidebar")
        
    <div class="main-content">
        <header class="top-header">
            <div class="header-left">
                <span class="page-title">
                    <i class="fas fa-chart-pie me-2 text-primary"></i>
                    CBC Performance Report
                </span>
            </div>
            <div class="header-right">
                <a href="/Reports/CBCPerformancePdf?termId=@ViewBag.TermId&classId=@ViewBag.ClassId&studentId=@ViewBag.StudentId&download=false" target="_blank" class="btn btn-outline-primary btn-sm me-2">
    <i class="fas fa-eye me-1"></i> Preview
</a>
<a href="/Reports/CBCPerformancePdf?termId=@ViewBag.TermId&classId=@ViewBag.ClassId&studentId=@ViewBag.StudentId&download=true" class="btn btn-danger btn-sm me-2">
    <i class="fas fa-file-pdf me-1"></i> Download
</a>
                <button onclick="window.print()"
                        class="btn btn-outline-primary btn-sm me-2">
                    <i class="fas fa-print me-1"></i> Print
                </button>
                <a href="/Reports" class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-arrow-left me-1"></i> Back
                </a>
                <div class="user-avatar ms-2">
                    @(User.Identity?.Name?.Substring(0,1).ToUpper() ?? "A")
                </div>
                <form asp-action="Logout" asp-controller="Account"
                      method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="header-btn" title="Logout">
                        <i class="fas fa-sign-out-alt"></i>
                    </button>
                </form>
            </div>
        </header>
        <div class="content-area">
            <div class="card mb-4">
                <div class="card-body p-3">
                    <div class="row g-2">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Term</label>
                            <select id="termSelect" class="form-control">
                                <option value="">All Terms</option>
                                @foreach (var term in ViewBag.Terms)
                                {
                                    if (ViewBag.TermId != null &&
                                        ViewBag.TermId == term.Id)
                                    {
                                        <option value="@term.Id" selected>
                                            @term.AcademicYear.Name - @term.Name
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@term.Id">
                                            @term.AcademicYear.Name - @term.Name
                                        </option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Class</label>
                            <select id="classSelect" class="form-control">
                                <option value="">All Classes</option>
                                @foreach (var cls in ViewBag.Classes)
                                {
                                    if (ViewBag.ClassId != null &&
                                        ViewBag.ClassId == cls.Id)
                                    {
                                        <option value="@cls.Id" selected>
                                            @cls.Name
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@cls.Id">@cls.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <button class="btn btn-primary w-100"
                                    onclick="applyFilter()">
                                <i class="fas fa-search me-1"></i> Filter
                            </button>
                        </div>
                    </div>
                </div>
            </div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="card mb-4">
    <div class="card-header">
        <i class="fas fa-chart-bar me-2 text-primary"></i>
        <strong>Class Performance Trend (ME + EE %) — Last Terms</strong>
    </div>
    <div class="card-body">
        <canvas id="classTrendChart" height="90"></canvas>
    </div>
</div>
            <div class="card">
                <div class="card-header">
                    <strong>Performance by Learning Area</strong>
                    <span class="badge bg-primary ms-2">
                        @ViewBag.TotalStudents students assessed
                    </span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Learning Area</th>
                                <th class="text-center">Total</th>
                                <th class="text-center text-primary">EE</th>
                                <th class="text-center text-success">ME</th>
                                <th class="text-center text-warning">AE</th>
                                <th class="text-center text-danger">BE</th>
                                <th class="text-center">ME+EE %</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.SubjectSummary != null)
                            {
                                foreach (var s in ViewBag.SubjectSummary)
                                {
                                    var meEeRate = s.Total > 0
                                        ? Math.Round((double)(s.ME + s.EE) /
                                            s.Total * 100, 1) : 0;
                                    <tr>
                                        <td><strong>@s.Subject.Name</strong></td>
                                        <td class="text-center">@s.Total</td>
                                        <td class="text-center">
                                            <span class="badge bg-primary">@s.EE</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-success">@s.ME</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-warning text-dark">@s.AE</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-danger">@s.BE</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge @(meEeRate >= 70 ? "bg-success" : meEeRate >= 50 ? "bg-warning text-dark" : "bg-danger")">
                                                @meEeRate%
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                <div class="card-footer small text-muted">
                    EE = Exceeds Expectation | ME = Meets Expectation |
                    AE = Approaching Expectation | BE = Below Expectation
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function applyFilter() {
        const termId = document.getElementById('termSelect').value;
        const classId = document.getElementById('classSelect').value;
        let url = '/Reports/CBCPerformance?';
        if (termId) url += 'termId=' + termId + '&';
        if (classId) url += 'classId=' + classId;
        window.location = url;
    }

    try {
        const trendLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.TrendTermLabels));
        const trendSeries = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ClassTrendSeries));

        const palette = ['#1a56db','#057a55','#d97706','#dc2626','#7c3aed',
                          '#0891b2','#db2777','#65a30d','#ea580c','#0284c7','#9333ea'];

        new Chart(document.getElementById('classTrendChart'), {
            type: 'bar',
            data: {
                labels: trendLabels,
                datasets: trendSeries.map((s, idx) => ({
                    label: s.ClassName,
                    data: s.Values,
                    backgroundColor: palette[idx % palette.length]
                }))
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { position: 'bottom' },
                    tooltip: {
                        callbacks: {
                            label: ctx => ctx.dataset.label + ': ' + (ctx.parsed.y ?? '—') + '%'
                        }
                    }
                },
                scales: {
                    y: { beginAtZero: true, max: 100, ticks: { callback: v => v + '%' } }
                }
            }
        });
    } catch(e) { console.log('Class trend chart error:', e); }
</script>
}