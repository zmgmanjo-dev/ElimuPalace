@model List<SMIS.Domain.Entities.Finance.StudentInvoice>
@{
    ViewData["Title"] = "Student Fee Statement";
    var student = ViewBag.Student as SMIS.Domain.Entities.Students.Student;
    var school = ViewBag.School as SMIS.Domain.Entities.School.SchoolProfile;
    ViewBag.ReportTitle = "Student Fee Statement";
    ViewBag.ReportSubtitle = student != null
        ? $"Student: {student.FullName} | Adm: {student.AdmissionNumber}" : "";
}

<div class="app-wrapper">
    @await Html.PartialAsync("_Sidebar")
        
    <div class="main-content">
        <header class="top-header d-print-none">
            <div class="header-left">
                <span class="page-title">
                    <i class="fas fa-file-alt me-2 text-primary"></i>
                    Student Fee Statement
                </span>
            </div>
            <div class="header-right">
                @if (student != null)
{
    <a href="/Reports/StudentStatementPdf?studentId=@ViewBag.StudentId&download=false" target="_blank" class="btn btn-outline-primary btn-sm me-2">
        <i class="fas fa-eye me-1"></i> Preview
    </a>
    <a href="/Reports/StudentStatementPdf?studentId=@ViewBag.StudentId&download=true" class="btn btn-danger btn-sm me-2">
        <i class="fas fa-file-pdf me-1"></i> Download
    </a>
                    <button onclick="window.print()"
                            class="btn btn-success btn-sm me-2">
                        <i class="fas fa-print me-1"></i> Print Statement
                    </button>
                }
                <a href="/Reports" class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-arrow-left me-1"></i> Back
                </a>
                <div class="user-avatar ms-2">
                    @(User.Identity?.Name?.Substring(0,1).ToUpper() ?? "A")
                </div>
                <form asp-action="Logout" asp-controller="Account"
                      method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="header-btn" title="Logout">
                        <i class="fas fa-sign-out-alt"></i>
                    </button>
                </form>
            </div>
        </header>

        <div class="content-area">
            @* Print Header *@
            @await Html.PartialAsync("_PrintHeader")

            @* Student Selector *@
            <div class="card mb-4 d-print-none">
                <div class="card-body p-3">
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">
                                Select Student
                            </label>
                            <select class="form-control"
                                    onchange="window.location='/Reports/StudentStatement?studentId='+this.value">
                                <option value="">-- Select Student --</option>
                                @foreach (var s in ViewBag.Students)
                                {
                                    if (ViewBag.StudentId != null &&
                                        ViewBag.StudentId == s.Id)
                                    {
                                        <option value="@s.Id" selected>
                                            @s.AdmissionNumber — @s.FullName
                                            (@(s.ClassLevel?.Name ?? "No Class"))
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@s.Id">
                                            @s.AdmissionNumber — @s.FullName
                                            (@(s.ClassLevel?.Name ?? "No Class"))
                                        </option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            @if (student == null)
            {
                <div class="card">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-user-graduate fa-3x text-muted mb-3"></i>
                        <h5 class="text-muted">Select a Student</h5>
                        <p class="text-muted">
                            Choose a student above to view their fee statement.
                        </p>
                    </div>
                </div>
            }
            else
            {
                @* Student Info *@
                <div class="card mb-4">
                    <div class="card-body p-4">
                        <div class="row">
                            <div class="col-md-6">
                                <h5 class="fw-bold">@student.FullName</h5>
                                <table class="table table-sm mb-0">
                                    <tr>
                                        <td class="fw-bold text-muted"
                                            style="width:40%">Admission No:</td>
                                        <td>@student.AdmissionNumber</td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold text-muted">Class:</td>
                                        <td>@(student.ClassLevel?.Name ?? "-")</td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold text-muted">
                                            Parent Phone:
                                        </td>
                                        <td>
                                            @(student.FatherPhone ??
                                                student.MotherPhone ?? "-")
                                        </td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-md-6 text-md-end">
                                <div class="row g-2">
                                    <div class="col-4">
                                        <div class="p-3 bg-light rounded text-center">
                                            <div class="fw-bold text-primary">
                                                KES @(((decimal)ViewBag.TotalInvoiced).ToString("N0"))
                                            </div>
                                            <small class="text-muted">Invoiced</small>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="p-3 bg-light rounded text-center">
                                            <div class="fw-bold text-success">
                                                KES @(((decimal)ViewBag.TotalPaid).ToString("N0"))
                                            </div>
                                            <small class="text-muted">Paid</small>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="p-3 rounded text-center
                                            @(((decimal)ViewBag.TotalBalance) > 0 ? "bg-danger text-white" : "bg-success text-white")">
                                            <div class="fw-bold">
                                                KES @(((decimal)ViewBag.TotalBalance).ToString("N0"))
                                            </div>
                                            <small>Balance</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
@* Statement Ledger — running balance *@
<div class="card mb-4">
    <div class="card-header">
        <i class="fas fa-receipt me-2 text-primary"></i>
        <strong>Statement Ledger</strong>
        <span class="text-muted small ms-2">Chronological record with running balance</span>
    </div>
    @{
        var ledger = ViewBag.Ledger as List<dynamic>;
    }
    @if (ledger == null || !ledger.Any())
    {
        <div class="card-body text-center py-4">
            <p class="text-muted mb-0">No transactions recorded yet.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Description</th>
                        <th>Term</th>
                        <th class="text-end">Invoiced (KES)</th>
                        <th class="text-end">Paid (KES)</th>
                        <th class="text-end">Balance (KES)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in ledger)
                    {
                        <tr>
                            <td>@(((DateTime)l.Date).ToString("dd MMM yyyy"))</td>
                            <td>@l.Description</td>
                            <td class="text-muted small">@l.Term</td>
                            <td class="text-end">
                                @(((decimal)l.Debit) > 0 ? ((decimal)l.Debit).ToString("N0") : "-")
                            </td>
                            <td class="text-end text-success">
                                @(((decimal)l.Credit) > 0 ? ((decimal)l.Credit).ToString("N0") : "-")
                            </td>
                            <td class="text-end fw-bold @(((decimal)l.Balance) > 0 ? "text-danger" : "text-success")">
                                @(((decimal)l.Balance).ToString("N0"))
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <td colspan="5" class="fw-bold text-end">CURRENT BALANCE:</td>
                        <td class="text-end fw-bold fs-6 @(((decimal)ViewBag.TotalBalance) > 0 ? "text-danger" : "text-success")">
                            KES @(((decimal)ViewBag.TotalBalance).ToString("N0"))
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
</div>
                @* Invoices *@
                @if (!Model.Any())
                {
                    <div class="card">
                        <div class="card-body text-center py-4">
                            <p class="text-muted">
                                No invoices found for this student.
                            </p>
                        </div>
                    </div>
                }
                else
                {
                    @foreach (var invoice in Model)
                    {
                        <div class="card mb-3">
                            <div class="card-header d-flex
                                        justify-content-between">
                                <span>
                                    <strong>@invoice.InvoiceNumber</strong>
                                    — @invoice.AcademicYear.Name
                                    @invoice.AcademicTerm.Name
                                </span>
                                @switch (invoice.Status)
                                {
                                    case SMIS.Domain.Entities.Finance.InvoiceStatus.Paid:
                                        <span class="badge bg-success">PAID</span>
                                        break;
                                    case SMIS.Domain.Entities.Finance.InvoiceStatus.PartiallyPaid:
                                        <span class="badge bg-warning text-dark">PARTIAL</span>
                                        break;
                                    default:
                                        <span class="badge bg-danger">UNPAID</span>
                                        break;
                                }
                            </div>
                            <div class="card-body p-0">
                                <table class="table table-bordered mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Description</th>
                                            <th class="text-end">Amount</th>
                                            <th class="text-end">Discount</th>
                                            <th class="text-end">Net</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in invoice.Items)
                                        {
                                            <tr>
                                                <td>@item.Description</td>
                                                <td class="text-end">
                                                    @item.Amount.ToString("N0")
                                                </td>
                                                <td class="text-end">
                                                    @(item.Discount > 0 ? item.Discount.ToString("N0") : "-")
                                                </td>
                                                <td class="text-end fw-bold">
                                                    @item.NetAmount.ToString("N0")
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot class="table-light">
                                        <tr>
                                            <td colspan="3" class="fw-bold text-end">
                                                Total:
                                            </td>
                                            <td class="text-end fw-bold">
                                                KES @invoice.TotalAmount.ToString("N0")
                                            </td>
                                        </tr>
                                        <tr>
                                            <td colspan="3" class="text-end text-success fw-bold">
                                                Paid:
                                            </td>
                                            <td class="text-end text-success fw-bold">
                                                KES @invoice.TotalPaid.ToString("N0")
                                            </td>
                                        </tr>
                                        <tr>
                                            <td colspan="3" class="text-end text-danger fw-bold">
                                                Balance:
                                            </td>
                                            <td class="text-end text-danger fw-bold">
                                                KES @invoice.Balance.ToString("N0")
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>

                                @if (invoice.Payments.Any())
                                {
                                    <div class="p-3 border-top bg-light">
                                        <strong class="small">PAYMENTS:</strong>
                                        <table class="table table-sm mb-0 mt-1">
                                            <thead>
                                                <tr>
                                                    <th>Receipt</th>
                                                    <th>Date</th>
                                                    <th>Method</th>
                                                    <th>Reference</th>
                                                    <th class="text-end">Amount</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var p in invoice.Payments)
                                                {
                                                    <tr>
                                                        <td>
                                                            <span class="badge bg-success">
                                                                @p.ReceiptNumber
                                                            </span>
                                                        </td>
                                                        <td>
                                                            @p.PaymentDate.ToString("dd MMM yyyy")
                                                        </td>
                                                        <td>@p.PaymentMethod</td>
                                                        <td class="text-muted">
                                                            @(p.ReferenceNumber ?? "-")
                                                        </td>
                                                        <td class="text-end fw-bold text-success">
                                                            KES @p.Amount.ToString("N0")
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @* Print Footer *@
                    <div class="d-none d-print-block mt-4 pt-3 border-top">
                        <div class="row">
                            <div class="col-6">
                                <p class="small text-muted mb-0">
                                    Prepared by: _________________
                                </p>
                                <p class="small text-muted">Bursar</p>
                            </div>
                            <div class="col-6 text-end">
                                <p class="small text-muted mb-0">
                                    Official Stamp:
                                </p>
                                <br/>
                                <p class="small text-muted">
                                    _________________
                                </p>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>