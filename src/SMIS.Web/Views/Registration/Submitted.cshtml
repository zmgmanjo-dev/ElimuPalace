@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Registration Submitted — Elimu Palace</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body style="background:linear-gradient(135deg,#0f2a4a,#1a56db,#057a55); min-height:100vh;">
    <div class="container py-5 d-flex align-items-center" style="min-height:100vh;">
        <div class="row justify-content-center w-100">
            <div class="col-md-6">
                <div class="card shadow-lg text-center">
                    <div class="card-body p-5">
                        <i class="fas fa-check-circle fa-4x text-success mb-3"></i>
                        <h4 class="fw-bold">Registration Submitted!</h4>
                        <p class="text-muted">
                            Thank you for registering. Our team will review your application
                            and activate your account shortly. You'll be able to log in once approved.
                        </p>
                        <a href="/" class="btn btn-outline-primary mt-2">Return Home</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>