@model SMIS.Domain.Entities.Finance.StudentInvoice
@{
    ViewData["Title"] = "Invoice Details";
}

<div class="app-wrapper">
    @await Html.PartialAsync("_Sidebar")
        
    <div class="main-content">
        <header class="top-header">
            <div class="header-left">
                <span class="page-title">
                    <i class="fas fa-file-invoice-dollar me-2 text-primary"></i>
                    Invoice — @Model.InvoiceNumber
                </span>
            </div>
            <div class="header-right">
                <a href="/Finance/Invoices"
                   class="btn btn-outline-secondary btn-sm me-2">
                    <i class="fas fa-arrow-left me-1"></i> Back
                </a>
                <a href="/Finance/DownloadInvoice/@Model.Id"
                   class="btn btn-success btn-sm me-2" target="_blank">
                    <i class="fas fa-download me-1"></i> Download PDF
                </a>
                <button onclick="window.print()"
                        class="btn btn-outline-primary btn-sm me-2">
                    <i class="fas fa-print me-1"></i> Print
                </button>
                <div class="user-avatar ms-2">
                    @(User.Identity?.Name?.Substring(0,1).ToUpper() ?? "A")
                </div>
                <form asp-action="Logout" asp-controller="Account"
                      method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="header-btn" title="Logout">
                        <i class="fas fa-sign-out-alt"></i>
                    </button>
                </form>
            </div>
        </header>

        <div class="content-area">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-4">
                    <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                    @if (TempData["NewReceiptId"] != null)
                    {
                        <div class="mt-2">
                            <a href="/Finance/DownloadReceipt/@TempData["NewReceiptId"]"
                               class="btn btn-success btn-sm me-2" target="_blank">
                                <i class="fas fa-download me-1"></i> Download Receipt
                            </a>
                            <button onclick="window.open('/Finance/DownloadReceipt/@TempData["NewReceiptId"]', '_blank')"
                                    class="btn btn-outline-success btn-sm">
                                <i class="fas fa-print me-1"></i> Print Receipt
                            </button>
                        </div>
                    }
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="row g-4">
                @* Invoice Details *@
                <div class="col-md-8">
                    <div class="card mb-4">
                        <div class="card-header d-flex justify-content-between">
                            <span>
                                <i class="fas fa-file-invoice me-2 text-primary"></i>
                                <strong>@Model.InvoiceNumber</strong>
                            </span>
                            @switch (Model.Status)
                            {
                                case SMIS.Domain.Entities.Finance.InvoiceStatus.Paid:
                                    <span class="badge bg-success fs-6">PAID</span>
                                    break;
                                case SMIS.Domain.Entities.Finance.InvoiceStatus.PartiallyPaid:
                                    <span class="badge bg-warning text-dark fs-6">PARTIALLY PAID</span>
                                    break;
                                case SMIS.Domain.Entities.Finance.InvoiceStatus.Unpaid:
                                    <span class="badge bg-danger fs-6">UNPAID</span>
                                    break;
                            }
                        </div>
                        <div class="card-body p-4">
                            <div class="row mb-4">
                                <div class="col-md-6">
                                    <h6 class="text-muted mb-2">BILLED TO</h6>
                                    <h5 class="fw-bold">@Model.Student.FullName</h5>
                                    <p class="text-muted mb-0">
                                        Adm: @Model.Student.AdmissionNumber<br/>
                                        Class: @(Model.Student.ClassLevel?.Name ?? "-")
                                    </p>
                                </div>
                                <div class="col-md-6 text-md-end">
                                    <h6 class="text-muted mb-2">INVOICE INFO</h6>
                                    <p class="mb-0">
                                        <strong>Date:</strong>
                                        @Model.InvoiceDate.ToString("dd MMM yyyy")<br/>
                                        <strong>Due:</strong>
                                        @Model.DueDate.ToString("dd MMM yyyy")<br/>
                                        <strong>Term:</strong>
                                        @Model.AcademicYear.Name — @Model.AcademicTerm.Name
                                    </p>
                                </div>
                            </div>

                            <table class="table mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Description</th>
                                        <th class="text-end">Amount</th>
                                        <th class="text-end">Discount</th>
                                        <th class="text-end">Net Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Items)
                                    {
                                        <tr>
                                            <td>@item.Description</td>
                                            <td class="text-end">
                                                KES @item.Amount.ToString("N0")
                                            </td>
                                            <td class="text-end text-danger">
                                                @(item.Discount > 0 ? $"KES {item.Discount:N0}" : "-")
                                            </td>
                                            <td class="text-end fw-bold">
                                                KES @item.NetAmount.ToString("N0")
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-light">
                                    <tr>
                                        <td colspan="3" class="text-end fw-bold">
                                            Total Invoiced:
                                        </td>
                                        <td class="text-end fw-bold text-primary">
                                            KES @Model.TotalAmount.ToString("N0")
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="3" class="text-end fw-bold">
                                            Total Paid:
                                        </td>
                                        <td class="text-end fw-bold text-success">
                                            KES @Model.TotalPaid.ToString("N0")
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="3" class="text-end fw-bold">
                                            Balance:
                                        </td>
                                        <td class="text-end fw-bold text-danger fs-5">
                                            KES @Model.Balance.ToString("N0")
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>

                    @* Payment History *@
                    <div class="card">
                        <div class="card-header">
                            <i class="fas fa-history me-2 text-success"></i>
                            <strong>Payment History</strong>
                        </div>
                        @if (!Model.Payments.Any())
                        {
                            <div class="card-body text-center py-4">
                                <p class="text-muted mb-0">No payments recorded yet.</p>
                            </div>
                        }
                        else
                        {
                            <table class="table mb-0">
                                <thead>
                                    <tr>
                                        <th>Receipt No.</th>
                                        <th>Date</th>
                                        <th>Method</th>
                                        <th>Reference</th>
                                        <th class="text-end">Amount</th>
                                        <th>Receipt</th>
                                    </tr>
                                </thead>
                                <tbody>
    @foreach (var payment in Model.Payments
        .OrderByDescending(p => p.PaymentDate))
    {
        <tr class="@(payment.IsReversed ? "table-secondary text-muted" : "")">
            <td>
                @if (payment.IsReversed)
                {
                    <span class="badge bg-secondary text-decoration-line-through">
                        @payment.ReceiptNumber
                    </span>
                    <span class="badge bg-danger ms-1">VOIDED</span>
                }
                else
                {
                    <span class="badge bg-success">
                        @payment.ReceiptNumber
                    </span>
                }
            </td>
            <td>
                @payment.PaymentDate.ToString("dd MMM yyyy")
            </td>
            <td>@payment.PaymentMethod</td>
            <td class="text-muted">
                @(payment.ReferenceNumber ?? "-")
            </td>
            <td class="text-end fw-bold @(payment.IsReversed ? "text-muted" : "text-success")">
                KES @payment.Amount.ToString("N0")
            </td>
            <td>
                <div class="d-flex gap-1">
                    <a href="/Finance/DownloadReceipt/@payment.Id"
                       class="btn btn-sm btn-outline-success"
                       target="_blank">
                        <i class="fas fa-download"></i>
                    </a>
                    @if (!payment.IsReversed)
                    {
                        <form asp-action="VoidPayment" asp-controller="Finance"
                              method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="paymentId" value="@payment.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                    title="Void this payment"
                                    onclick="return confirm('Void receipt @payment.ReceiptNumber for KES @payment.Amount.ToString("N0")? This will remove it from the Cashbook and General Ledger, and reduce the invoice paid amount. This cannot be undone.')">
                                <i class="fas fa-undo"></i>
                            </button>
                        </form>
                    }
                </div>
            </td>
        </tr>
    }
</tbody>
                            </table>
                        }
                    </div>
                </div>

                @* Record Payment *@
                <div class="col-md-4">
                    @if (Model.Status != SMIS.Domain.Entities.Finance.InvoiceStatus.Paid)
                    {
                        <div class="card">
                            <div class="card-header">
                                <i class="fas fa-money-bill-wave me-2 text-success"></i>
                                <strong>Record Payment</strong>
                            </div>
                            <div class="card-body p-4">
                                <form asp-action="RecordPayment"
                                      asp-controller="Finance" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="invoiceId"
                                           value="@Model.Id" />
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">
                                            Amount (KES) <span class="text-danger">*</span>
                                        </label>
                                        <input type="number" name="amount"
                                               class="form-control form-control-lg"
                                               placeholder="0.00"
                                               max="@Model.Balance"
                                               step="0.01" required />
                                        <small class="text-muted">
                                            Balance: KES @Model.Balance.ToString("N0")
                                        </small>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">
                                            Payment Method <span class="text-danger">*</span>
                                        </label>
                                        <select name="paymentMethod" class="form-control"
                                                required>
                                            <option value="1">Cash</option>
                                            <option value="2">M-Pesa</option>
                                            <option value="3">Bank Transfer</option>
                                            <option value="4">Cheque</option>
                                            <option value="5">Online</option>
                                        </select>
                                    </div>
                                    <div class="mb-3">
    <label class="form-label fw-bold">Received Into <span class="text-danger">*</span></label>
    <select name="cashAccountId" class="form-control" required>
        <option value="">-- Select Account --</option>
        @foreach (var acc in (List<SMIS.Domain.Entities.Accounting.Account>)ViewBag.CashAccounts)
        {
            <option value="@acc.Id">@acc.Name</option>
        }
    </select>
</div>
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">
                                            Reference No.
                                        </label>
                                        <input type="text" name="referenceNumber"
                                               class="form-control"
                                               placeholder="M-Pesa code, Cheque no." />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Notes</label>
                                        <textarea name="notes" class="form-control"
                                                  rows="2"></textarea>
                                    </div>
                                    <button type="submit"
                                            class="btn btn-success w-100">
                                        <i class="fas fa-check me-2"></i>
                                        Record Payment
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="card">
                            <div class="card-body text-center py-5">
                                <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                                <h5 class="text-success">Fully Paid!</h5>
                                <p class="text-muted">
                                    This invoice has been fully settled.
                                </p>
                            </div>
                        </div>
                    }

                    @* Quick Links *@
                    <div class="card mt-4">
                        <div class="card-header">
                            <i class="fas fa-link me-2 text-primary"></i>
                            Quick Links
                        </div>
                        <div class="card-body p-3">
                            <a href="/Students/Details/@Model.StudentId"
                               class="btn btn-outline-primary w-100 mb-2">
                                <i class="fas fa-user me-2"></i>View Student Profile
                            </a>
                            <a href="/Reports/StudentStatement?studentId=@Model.StudentId"
   class="btn btn-outline-secondary w-100 mb-2">
    <i class="fas fa-file-alt me-2"></i>Fee Statement
</a>
                            <a href="/Finance/DownloadInvoice/@Model.Id"
                               class="btn btn-outline-success w-100" target="_blank">
                                <i class="fas fa-download me-2"></i>Download Invoice PDF
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>