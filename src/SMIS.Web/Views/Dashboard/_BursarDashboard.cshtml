<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <a href="/Finance/Invoices" class="text-decoration-none">
            <div class="stat-card">
                <div class="stat-icon green"><i class="fas fa-money-bill-wave"></i></div>
                <div>
                    <div class="stat-value">KES @(((decimal)ViewBag.TodayCollection).ToString("N0"))</div>
                    <div class="stat-label">Collected Today</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a href="/Reports/FeeCollection" class="text-decoration-none">
            <div class="stat-card">
                <div class="stat-icon blue"><i class="fas fa-chart-line"></i></div>
                <div>
                    <div class="stat-value">KES @(((decimal)ViewBag.TermCollection).ToString("N0"))</div>
                    <div class="stat-label">Collected This Term</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a href="/Reports/OutstandingFees" class="text-decoration-none">
            <div class="stat-card">
                <div class="stat-icon purple"><i class="fas fa-exclamation-circle"></i></div>
                <div>
                    <div class="stat-value">KES @(((decimal)ViewBag.TermOutstanding).ToString("N0"))</div>
                    <div class="stat-label">Outstanding</div>
                    <small class="text-muted">@ViewBag.UnpaidInvoiceCount invoices</small>
                </div>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a href="/Accounting/Cashbook" class="text-decoration-none">
            <div class="stat-card">
                <div class="stat-icon orange"><i class="fas fa-wallet"></i></div>
                <div>
                    <div class="stat-value">@ViewBag.CashAccountsCount</div>
                    <div class="stat-label">Cash/Bank Accounts</div>
                </div>
            </div>
        </a>
    </div>
</div>

@* Chart — Term Fee Status *@
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-header">
                <i class="fas fa-chart-pie me-2 text-primary"></i><strong>Term Fee Status</strong>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center">
                <canvas id="bursarFeeChart" width="220" height="220"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card h-100">
            <div class="card-header">
                <i class="fas fa-bolt me-2 text-primary"></i><strong>Quick Actions</strong>
            </div>
            <div class="card-body">
                <div class="row g-2">
                    <div class="col-6">
                        <a href="/Finance/Invoices" class="btn btn-outline-primary w-100 py-3">
                            <i class="fas fa-file-invoice-dollar d-block fa-lg mb-1"></i>Invoices
                        </a>
                    </div>
                    <div class="col-6">
                        <a href="/Finance/BulkInvoice" class="btn btn-outline-warning w-100 py-3">
                            <i class="fas fa-layer-group d-block fa-lg mb-1"></i>Bulk Invoices
                        </a>
                    </div>
                    <div class="col-6">
                        <a href="/Accounting/Cashbook" class="btn btn-outline-success w-100 py-3">
                            <i class="fas fa-book d-block fa-lg mb-1"></i>Cashbook
                        </a>
                    </div>
                    <div class="col-6">
                        <a href="/Reports/OutstandingFees" class="btn btn-outline-secondary w-100 py-3">
                            <i class="fas fa-chart-bar d-block fa-lg mb-1"></i>Outstanding Report
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-12">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between">
                <span><i class="fas fa-money-bill-wave me-2 text-success"></i><strong>Recent Payments</strong></span>
                <a href="/Finance/Invoices" class="btn btn-sm btn-outline-success">View All</a>
            </div>
            @{
                var payments = ViewBag.RecentPayments as List<SMIS.Domain.Entities.Finance.FeePayment>;
            }
            @if (payments == null || !payments.Any())
            {
                <div class="card-body text-center py-3">
                    <p class="text-muted mb-0">No recent payments.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <tbody>
                            @foreach (var p in payments)
                            {
                                <tr>
                                    <td><span class="badge bg-success">@p.ReceiptNumber</span></td>
                                    <td>@p.Student.FullName</td>
                                    <td class="text-end fw-bold text-success">KES @p.Amount.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<script>
    try {
        new Chart(document.getElementById('bursarFeeChart'), {
            type: 'doughnut',
            data: {
                labels: ['Collected This Term', 'Outstanding'],
                datasets: [{
                    data: [
                        @(((decimal)ViewBag.TermCollection)),
                        @(((decimal)ViewBag.TermOutstanding))
                    ],
                    backgroundColor: ['#057a55', '#dc2626'],
                    borderWidth: 2
                }]
            },
            options: {
                responsive: false,
                plugins: {
                    legend: { position: 'bottom' },
                    tooltip: {
                        callbacks: {
                            label: ctx => ctx.label + ': KES ' + ctx.parsed.toLocaleString()
                        }
                    }
                }
            }
        });
    } catch(e) { console.log('Bursar fee chart error:', e); }
</script>