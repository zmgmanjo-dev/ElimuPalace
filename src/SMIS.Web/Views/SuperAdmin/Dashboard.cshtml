@model List<SMIS.Domain.Entities.Platform.SchoolRegistration>
@using SMIS.Domain.Entities.Platform
@{
    Layout = null;
    ViewData["Title"] = "Super Admin Dashboard";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Super Admin Dashboard</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body style="background:#f3f4f6;">
    <nav class="navbar navbar-dark" style="background:#0f172a;">
        <div class="container-fluid">
            <span class="navbar-brand fw-bold">
                <i class="fas fa-shield-alt me-2"></i>Super Admin
            </span>
            <div class="d-flex align-items-center">
                <span class="text-white small me-3">@User.Identity?.Name</span>
                <form asp-action="Logout" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-light">
                        <i class="fas fa-sign-out-alt me-1"></i>Logout
                    </button>
                </form>
            </div>
        </div>
    </nav>

    <div class="container py-4">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <a href="/SuperAdmin/Dashboard?status=Pending" class="text-decoration-none">
                    <div class="card border-warning">
                        <div class="card-body text-center">
                            <div class="fs-3 fw-bold text-warning">@ViewBag.PendingCount</div>
                            <div class="text-muted small">Pending Applications</div>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-md-4">
                <a href="/SuperAdmin/Dashboard?status=Approved" class="text-decoration-none">
                    <div class="card border-success">
                        <div class="card-body text-center">
                            <div class="fs-3 fw-bold text-success">@ViewBag.ApprovedCount</div>
                            <div class="text-muted small">Active Schools</div>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-md-4">
                <a href="/SuperAdmin/Dashboard?status=Suspended" class="text-decoration-none">
                    <div class="card border-danger">
                        <div class="card-body text-center">
                            <div class="fs-3 fw-bold text-danger">@ViewBag.SuspendedCount</div>
                            <div class="text-muted small">Suspended</div>
                        </div>
                    </div>
                </a>
            </div>
        </div>

        <div class="mb-3">
            <a href="/SuperAdmin/Dashboard" class="btn btn-sm @(ViewBag.StatusFilter == null ? "btn-dark" : "btn-outline-dark")">All</a>
            <a href="/SuperAdmin/Dashboard?status=Pending" class="btn btn-sm @(ViewBag.StatusFilter == "Pending" ? "btn-warning" : "btn-outline-warning")">Pending</a>
            <a href="/SuperAdmin/Dashboard?status=Approved" class="btn btn-sm @(ViewBag.StatusFilter == "Approved" ? "btn-success" : "btn-outline-success")">Approved</a>
            <a href="/SuperAdmin/Dashboard?status=Rejected" class="btn btn-sm @(ViewBag.StatusFilter == "Rejected" ? "btn-secondary" : "btn-outline-secondary")">Rejected</a>
            <a href="/SuperAdmin/Dashboard?status=Suspended" class="btn btn-sm @(ViewBag.StatusFilter == "Suspended" ? "btn-danger" : "btn-outline-danger")">Suspended</a>
        </div>

        <div class="card">
            <div class="card-header"><strong>School Applications</strong></div>
            @if (!Model.Any())
            {
                <div class="card-body text-center py-5 text-muted">No applications found.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>School</th>
                                <th>URL</th>
                                <th>Contact</th>
                                <th>Admin</th>
                                <th>Submitted</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model)
                            {
                                <tr>
                                    <td><strong>@r.SchoolName</strong></td>
                                    <td><code>/@r.Slug</code></td>
                                    <td>@r.ContactEmail<br /><small class="text-muted">@r.ContactPhone</small></td>
                                    <td>@r.AdminFullName<br /><small class="text-muted">@r.AdminEmail</small></td>
                                    <td>@r.CreatedAt.ToString("dd MMM yyyy")</td>
                                    <td>
                                        @switch (r.Status)
                                        {
                                            case RegistrationStatus.Pending:
                                                <span class="badge bg-warning text-dark">Pending</span>
                                                break;
                                            case RegistrationStatus.Approved:
                                                <span class="badge bg-success">Approved</span>
                                                break;
                                            case RegistrationStatus.Rejected:
                                                <span class="badge bg-secondary">Rejected</span>
                                                break;
                                            case RegistrationStatus.Suspended:
                                                <span class="badge bg-danger">Suspended</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        @if (r.Status == RegistrationStatus.Pending)
                                        {
                                            <form asp-action="Approve" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@r.Id" />
                                                <button type="submit" class="btn btn-sm btn-success">Approve</button>
                                            </form>
                                            <button class="btn btn-sm btn-outline-danger"
                                                    data-bs-toggle="modal" data-bs-target="#rejectModal"
                                                    data-id="@r.Id" data-name="@r.SchoolName">
                                                Reject
                                            </button>
                                        }
                                        else if (r.Status == RegistrationStatus.Approved)
                                        {
                                            <form asp-action="Suspend" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@r.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Suspend</button>
                                            </form>
                                        }
                                        else if (r.Status == RegistrationStatus.Suspended)
                                        {
                                            <form asp-action="Reactivate" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@r.Id" />
                                                <button type="submit" class="btn btn-sm btn-success">Reactivate</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @* REJECT MODAL *@
    <div class="modal fade" id="rejectModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Reject <span id="rejectSchoolName"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form asp-action="Reject" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="rejectId" />
                    <div class="modal-body">
                        <label class="form-label">Reason (optional)</label>
                        <textarea name="reason" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">Confirm Reject</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.querySelectorAll('[data-bs-target="#rejectModal"]').forEach(btn => {
            btn.addEventListener('click', function() {
                document.getElementById('rejectId').value = this.dataset.id;
                document.getElementById('rejectSchoolName').textContent = this.dataset.name;
            });
        });
    </script>
</body>
</html>