@{
    ViewData["Title"] = "Create User";
}

<div class="app-wrapper">
    @await Html.PartialAsync("_Sidebar")
        
    <div class="main-content">
        <header class="top-header">
            <div class="header-left">
                <span class="page-title">
                    <i class="fas fa-user-plus me-2 text-primary"></i>
                    Create New User
                </span>
            </div>
            <div class="header-right">
                <a href="/UserManagement"
                   class="btn btn-outline-secondary btn-sm me-2">
                    <i class="fas fa-arrow-left me-1"></i> Back
                </a>
                <div class="user-avatar ms-2">
                    @(User.Identity?.Name?.Substring(0,1).ToUpper() ?? "A")
                </div>
                <form asp-action="Logout" asp-controller="Account"
                      method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="header-btn" title="Logout">
                        <i class="fas fa-sign-out-alt"></i>
                    </button>
                </form>
            </div>
        </header>

        <div class="content-area">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mb-4">
                    <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close"
                            data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="card">
                <div class="card-header">
                    <i class="fas fa-user-plus me-2 text-primary"></i>
                    <strong>New User Details</strong>
                </div>
                <div class="card-body p-4">
                    <form asp-action="CreateUser"
                          asp-controller="UserManagement" method="post">
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">
                                    Full Name <span class="text-danger">*</span>
                                </label>
                                <input type="text" name="fullName"
                                       class="form-control"
                                       placeholder="e.g. John Kamau"
                                       required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">
                                    Email Address <span class="text-danger">*</span>
                                </label>
                                <input type="email" name="email"
                                       class="form-control"
                                       placeholder="e.g. john@school.ac.ke"
                                       required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">
                                    Password <span class="text-danger">*</span>
                                </label>
                                <input type="password" name="password"
                                       class="form-control"
                                       placeholder="Minimum 6 characters"
                                       minlength="6" required />
                                <small class="text-muted">
                                    Must contain at least one digit (e.g. Pass@1234)
                                </small>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">
                                    Phone Number
                                </label>
                                <input type="text" name="phone"
                                       class="form-control"
                                       placeholder="e.g. 0712345678" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">
                                    Role <span class="text-danger">*</span>
                                </label>
                                <select name="role" class="form-control" required>
                                    <option value="">-- Select Role --</option>
                                    @foreach (var role in ViewBag.Roles)
                                    {
                                        <option value="@role.Name">@role.Name</option>
                                    }
                                </select>
                                <small class="text-muted">
                                    Role determines what the user can access
                                </small>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">
                                    Assigned Class (for Teachers)
                                </label>
                                <select name="classLevelId" class="form-control">
                                    <option value="">-- Select Class --</option>
                                    @foreach (var cls in ViewBag.Classes)
                                    {
                                        <option value="@cls.Id">@cls.Name</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="alert alert-info mt-4 small">
                            <i class="fas fa-info-circle me-2"></i>
                            The user will be able to log in immediately
                            using their email and password.
                        </div>

                        <div class="d-flex gap-2 mt-3">
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="fas fa-user-plus me-2"></i>
                                Create User
                            </button>
                            <a href="/UserManagement"
                               class="btn btn-outline-secondary px-4">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>