@model List<Microsoft.AspNetCore.Identity.IdentityUser>
@{
    ViewData["Title"] = "User Management";
    var userRoles = ViewBag.UserRoles as
        Dictionary<string, IList<string>>;
}

<div class="app-wrapper">
    @await Html.PartialAsync("_Sidebar")

    <div class="main-content">
        <header class="top-header">
            <div class="header-left">
                <span class="page-title">
                    <i class="fas fa-users-cog me-2 text-primary"></i>
                    User Management
                </span>
            </div>
            <div class="header-right">
                <a href="/UserManagement/CreateUser"
                   class="btn btn-primary btn-sm me-2">
                    <i class="fas fa-user-plus me-1"></i> Create User
                </a>
                <a href="/UserManagement/Roles"
                   class="btn btn-outline-primary btn-sm me-2">
                    <i class="fas fa-shield-alt me-1"></i> Roles
                </a>
                <div class="user-avatar ms-2">
                    @(User.Identity?.Name?.Substring(0,1).ToUpper() ?? "A")
                </div>
                <form asp-action="Logout" asp-controller="Account"
                      method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="header-btn" title="Logout">
                        <i class="fas fa-sign-out-alt"></i>
                    </button>
                </form>
            </div>
        </header>

        <div class="content-area">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-4">
                    <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close"
                            data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mb-4">
                    <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close"
                            data-bs-dismiss="alert"></button>
                </div>
            }

            @* Stats *@
            <div class="row g-3 mb-4">
                <div class="col-sm-6 col-xl-3">
                    <div class="stat-card">
                        <div class="stat-icon blue">
                            <i class="fas fa-users"></i>
                        </div>
                        <div>
                            <div class="stat-value">@Model.Count</div>
                            <div class="stat-label">Total Users</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="stat-card">
                        <div class="stat-icon green">
                            <i class="fas fa-user-check"></i>
                        </div>
                        <div>
                            <div class="stat-value">
                                @Model.Count(u => u.LockoutEnd == null ||
                                    u.LockoutEnd < DateTimeOffset.Now)
                            </div>
                            <div class="stat-label">Active Users</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="stat-card">
                        <div class="stat-icon orange">
                            <i class="fas fa-user-lock"></i>
                        </div>
                        <div>
                            <div class="stat-value">
                                @Model.Count(u => u.LockoutEnd.HasValue &&
                                    u.LockoutEnd > DateTimeOffset.Now)
                            </div>
                            <div class="stat-label">Inactive Users</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="stat-card">
                        <div class="stat-icon purple">
                            <i class="fas fa-shield-alt"></i>
                        </div>
                        <div>
                            <div class="stat-value">
                                @(userRoles?.Values
                                    .SelectMany(r => r).Distinct().Count() ?? 0)
                            </div>
                            <div class="stat-label">Roles Used</div>
                        </div>
                    </div>
                </div>
            </div>

            @* Users Table *@
            <div class="card">
                <div class="card-header">
                    <i class="fas fa-users me-2 text-primary"></i>
                    <strong>System Users</strong>
                    <span class="badge bg-primary ms-2">@Model.Count</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Status</th>
                                <th>Email Confirmed</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                var roles = userRoles?.GetValueOrDefault(user.Id)
                                    ?? new List<string>();
                                var isActive = !user.LockoutEnd.HasValue ||
                                    user.LockoutEnd < DateTimeOffset.Now;
                                <tr class="@(!isActive ? "table-secondary" : "")">
                                    <td>
                                        <i class="fas fa-user text-primary me-2"></i>
                                        <strong>@user.Email</strong>
                                        @if (user.PhoneNumber != null)
                                        {
                                            <small class="text-muted d-block">
                                                @user.PhoneNumber
                                            </small>
                                        }
                                    </td>
                                    <td>
                                        @foreach (var role in roles)
                                        {
                                            <span class="badge bg-primary me-1">
                                                @role
                                            </span>
                                        }
                                        @if (!roles.Any())
                                        {
                                            <span class="text-muted small">
                                                No role
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (isActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        @if (user.EmailConfirmed)
                                        {
                                            <span class="badge bg-success">
                                                <i class="fas fa-check"></i> Yes
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                No
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex gap-1">
                                            <a href="/UserManagement/EditUser/@user.Id"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <button class="btn btn-sm btn-outline-warning"
                                                    title="Reset Password"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#resetPasswordModal"
                                                    data-user-id="@user.Id"
                                                    data-user-email="@user.Email">
                                                <i class="fas fa-key"></i>
                                            </button>
                                            <form asp-action="ToggleUser"
                                                  asp-controller="UserManagement"
                                                  method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id"
                                                       value="@user.Id" />
                                                <button type="submit"
                                                        class="btn btn-sm @(isActive ? "btn-outline-danger" : "btn-outline-success")"
                                                        title="@(isActive ? "Deactivate" : "Activate")">
                                                    <i class="fas @(isActive ? "fa-user-slash" : "fa-user-check")"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@* RESET PASSWORD MODAL *@
<div class="modal fade" id="resetPasswordModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-key me-2"></i>Reset Password
                </h5>
                <button type="button" class="btn-close"
                        data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="ResetPassword"
                  asp-controller="UserManagement" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="resetUserId" />
                <div class="modal-body">
                    <p class="text-muted">
                        Resetting password for:
                        <strong id="resetUserEmail"></strong>
                    </p>
                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            New Password <span class="text-danger">*</span>
                        </label>
                        <input type="password" name="newPassword"
                               class="form-control"
                               placeholder="Enter new password"
                               minlength="6" required />
                        <small class="text-muted">
                            Minimum 6 characters with at least one digit
                        </small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">
                        <i class="fas fa-key me-1"></i>Reset Password
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.querySelectorAll('[data-bs-target="#resetPasswordModal"]')
        .forEach(btn => {
            btn.addEventListener('click', function() {
                document.getElementById('resetUserId').value =
                    this.dataset.userId;
                document.getElementById('resetUserEmail').textContent =
                    this.dataset.userEmail;
            });
        });
</script>
}