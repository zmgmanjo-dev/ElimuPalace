@model List<Microsoft.AspNetCore.Identity.IdentityRole>
@{
    ViewData["Title"] = "Roles & Permissions";
    var roleUserCounts = ViewBag.RoleUserCounts as Dictionary<string, int>
        ?? new Dictionary<string, int>();
    var rolePermissions = ViewBag.RolePermissions as
        Dictionary<string, List<string>>
        ?? new Dictionary<string, List<string>>();
}

<div class="app-wrapper">
    @await Html.PartialAsync("_Sidebar")
        
    <div class="main-content">
        <header class="top-header">
            <div class="header-left">
                <span class="page-title">
                    <i class="fas fa-shield-alt me-2 text-primary"></i>
                    Roles & Permissions
                </span>
            </div>
            <div class="header-right">
                <a href="/UserManagement"
                   class="btn btn-outline-secondary btn-sm me-2">
                    <i class="fas fa-arrow-left me-1"></i> Back to Users
                </a>
                <div class="user-avatar ms-2">
                    @(User.Identity?.Name?.Substring(0,1).ToUpper() ?? "A")
                </div>
                <form asp-action="Logout" asp-controller="Account"
                      method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="header-btn" title="Logout">
                        <i class="fas fa-sign-out-alt"></i>
                    </button>
                </form>
            </div>
        </header>

        <div class="content-area">
            <div class="alert alert-info mb-4">
                <i class="fas fa-info-circle me-2"></i>
                Roles define what each user can access in the system.
                Assign roles when creating or editing users.
            </div>

            <div class="row g-4">
                @foreach (var role in Model)
                {
                    var count = roleUserCounts.GetValueOrDefault(role.Name ?? "", 0);
                    var permissions = rolePermissions.GetValueOrDefault(
                        role.Name ?? "", new List<string>());

                    var badgeColor = role.Name switch
                    {
                        "Administrator" => "danger",
                        "Principal" => "primary",
                        "DeputyPrincipal" => "info",
                        "AcademicMaster" => "success",
                        "Teacher" or "ClassTeacher" => "warning",
                        "Bursar" or "AccountsClerk" => "success",
                        "Librarian" => "secondary",
                        "Parent" => "info",
                        "Student" => "light",
                        _ => "secondary"
                    };

                    <div class="col-md-6 col-xl-4">
                        <div class="card h-100">
                            <div class="card-header d-flex justify-content-between
                                        align-items-center">
                                <span>
                                    <i class="fas fa-shield-alt me-2
                                       text-@badgeColor"></i>
                                    <strong>@role.Name</strong>
                                </span>
                                <span class="badge bg-@badgeColor">
                                    @count user@(count != 1 ? "s" : "")
                                </span>
                            </div>
                            <div class="card-body p-3">
                                @if (permissions.Any())
                                {
                                    <ul class="mb-0 small">
                                        @foreach (var permission in permissions)
                                        {
                                            <li class="mb-1">
                                                <i class="fas fa-check text-success me-1"></i>
                                                @permission
                                            </li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <p class="text-muted small mb-0">
                                        No specific permissions defined.
                                    </p>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>