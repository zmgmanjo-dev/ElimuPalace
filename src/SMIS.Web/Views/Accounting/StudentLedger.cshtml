@model List<SMIS.Web.Controllers.StudentLedgerEntry>
@{
    ViewData["Title"] = "Student Ledger";
    var student = ViewBag.Student as SMIS.Domain.Entities.Students.Student;
    var school = ViewBag.School as SMIS.Domain.Entities.School.SchoolProfile;
}

<div class="app-wrapper">
    @await Html.PartialAsync("_Sidebar")
        
    <div class="main-content">
        <header class="top-header d-print-none">
            <div class="header-left">
                <span class="page-title">
                    <i class="fas fa-user-tag me-2 text-primary"></i>
                    Student Ledger
                </span>
            </div>
            <div class="header-right">
                @if (student != null)
                {
                    <button onclick="window.print()"
                            class="btn btn-success btn-sm me-2">
                        <i class="fas fa-print me-1"></i> Print
                    </button>
                }
                <div class="user-avatar ms-2">
                    @(User.Identity?.Name?.Substring(0,1).ToUpper() ?? "A")
                </div>
                <form asp-action="Logout" asp-controller="Account"
                      method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="header-btn" title="Logout">
                        <i class="fas fa-sign-out-alt"></i>
                    </button>
                </form>
            </div>
        </header>

        <div class="content-area">
            @await Html.PartialAsync("_PrintHeader")

            @* Student Selector *@
            <div class="card mb-4 d-print-none">
                <div class="card-body p-3">
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">
                                Select Student
                            </label>
                            <select class="form-control"
                                    onchange="window.location='/Accounting/StudentLedger?studentId='+this.value">
                                <option value="">-- Select Student --</option>
                                @foreach (var s in ViewBag.Students)
                                {
                                    if (ViewBag.StudentId != null &&
                                        ViewBag.StudentId == s.Id)
                                    {
                                        <option value="@s.Id" selected>
                                            @s.AdmissionNumber — @s.FullName
                                            (@(s.ClassLevel?.Name ?? ""))
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@s.Id">
                                            @s.AdmissionNumber — @s.FullName
                                            (@(s.ClassLevel?.Name ?? ""))
                                        </option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            @if (student == null)
            {
                <div class="card">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-user-tag fa-3x text-muted mb-3"></i>
                        <h5 class="text-muted">Select a Student</h5>
                        <p class="text-muted">
                            Choose a student to view their fee ledger.
                        </p>
                    </div>
                </div>
            }
            else
            {
                @* Student Header *@
                <div class="card mb-4">
                    <div class="card-body p-4">
                        <div class="row">
                            <div class="col-md-6">
                                <h5 class="fw-bold">@student.FullName</h5>
                                <p class="text-muted mb-0">
                                    Adm No: @student.AdmissionNumber<br/>
                                    Class: @(student.ClassLevel?.Name ?? "-")
                                </p>
                            </div>
                            <div class="col-md-6 text-end">
                                <div class="p-3 rounded @(((decimal)ViewBag.Balance) > 0 ? "bg-danger" : "bg-success") text-white d-inline-block">
                                    <div class="fw-bold fs-5">
                                        KES @(((decimal)ViewBag.Balance).ToString("N2"))
                                    </div>
                                    <small>
                                        @(((decimal)ViewBag.Balance) > 0
                                            ? "Amount Owing" : "In Credit")
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @* Ledger Table *@
                <div class="card">
                    <div class="card-header">
                        <strong>Fee Account Ledger</strong>
                    </div>
                    @if (!Model.Any())
                    {
                        <div class="card-body text-center py-4">
                            <p class="text-muted">
                                No transactions found for this student.
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Date</th>
                                        <th>Reference</th>
                                        <th>Description</th>
                                        <th class="text-end text-danger">
                                            Charges (Dr)
                                        </th>
                                        <th class="text-end text-success">
                                            Payments (Cr)
                                        </th>
                                        <th class="text-end">Balance</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var entry in Model)
                                    {
                                        <tr class="@(entry.Type == "Payment" ? "table-success" : "")">
                                            <td>
                                                @entry.Date.ToString("dd MMM yyyy")
                                            </td>
                                            <td>
                                                <span class="badge @(entry.Type == "Payment" ? "bg-success" : "bg-primary")">
                                                    @entry.Reference
                                                </span>
                                            </td>
                                            <td>@entry.Description</td>
                                            <td class="text-end text-danger">
                                                @if (entry.Debit > 0)
                                                {
                                                    @entry.Debit.ToString("N2")
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </td>
                                            <td class="text-end text-success">
                                                @if (entry.Credit > 0)
                                                {
                                                    @entry.Credit.ToString("N2")
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </td>
                                            <td class="text-end fw-bold @(entry.Balance > 0 ? "text-danger" : "text-success")">
                                                @entry.Balance.ToString("N2")
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-light">
                                    <tr>
                                        <td colspan="3" class="fw-bold text-end">
                                            TOTALS:
                                        </td>
                                        <td class="text-end fw-bold text-danger">
                                            KES @Model.Sum(e => e.Debit).ToString("N2")
                                        </td>
                                        <td class="text-end fw-bold text-success">
                                            KES @Model.Sum(e => e.Credit).ToString("N2")
                                        </td>
                                        <td class="text-end fw-bold @(((decimal)ViewBag.Balance) > 0 ? "text-danger" : "text-success")">
                                            KES @(((decimal)ViewBag.Balance).ToString("N2"))
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                        <div class="card-footer d-print-block text-muted small">
                            @(school?.Name ?? "") |
                            Generated: @DateTime.Now.ToString("dd MMM yyyy HH:mm")
                        </div>
                    }
                </div>

                @* Print Footer *@
                <div class="d-none d-print-block mt-4 pt-3 border-top">
                    <div class="row">
                        <div class="col-6">
                            <p class="small text-muted mb-0">
                                Prepared by: _________________
                            </p>
                            <p class="small text-muted">Bursar</p>
                        </div>
                        <div class="col-6 text-end">
                            <p class="small text-muted mb-0">
                                Official Stamp:
                            </p>
                            <br/>
                            <p class="small text-muted">
                                _________________
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>