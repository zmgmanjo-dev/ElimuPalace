@model List<SMIS.Domain.Entities.Accounting.CashbookEntry>
@using SMIS.Domain.Entities.Accounting
@{
    ViewData["Title"] = "Cashbook";
    var cashAccounts = ViewBag.CashAccounts as List<Account> ?? new();
    var selectedAccount = ViewBag.SelectedAccount as Account;
    var school = ViewBag.School as SMIS.Domain.Entities.School.SchoolProfile;
}

<div class="app-wrapper">
    @await Html.PartialAsync("_Sidebar")

    <div class="main-content">
        <header class="top-header d-print-none">
            <div class="header-left">
                <span class="page-title">
                    <i class="fas fa-money-bill-wave me-2 text-primary"></i>
                    Cashbook
                </span>
            </div>
            <div class="header-right">
                <button onclick="window.print()"
                        class="btn btn-success btn-sm me-2">
                    <i class="fas fa-print me-1"></i> Print
                </button>
                <button class="btn btn-outline-primary btn-sm me-2"
                        data-bs-toggle="modal"
                        data-bs-target="#addAccountModal">
                    <i class="fas fa-plus me-1"></i> New Cash/Bank Account
                </button>
                <button class="btn btn-outline-info btn-sm me-2"
        data-bs-toggle="modal"
        data-bs-target="#transferModal">
    <i class="fas fa-exchange-alt me-1"></i> Transfer Funds
</button>
                @if (selectedAccount != null)
                {
                    <button class="btn btn-primary btn-sm"
                            data-bs-toggle="modal"
                            data-bs-target="#addEntryModal">
                        <i class="fas fa-plus me-1"></i> New Entry
                    </button>
                }
                <div class="user-avatar ms-2">
                    @(User.Identity?.Name?.Substring(0,1).ToUpper() ?? "A")
                </div>
                <form asp-action="Logout" asp-controller="Account"
                      method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="header-btn" title="Logout">
                        <i class="fas fa-sign-out-alt"></i>
                    </button>
                </form>
            </div>
        </header>

        <div class="content-area">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-4">
                    <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close"
                            data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mb-4">
                    <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close"
                            data-bs-dismiss="alert"></button>
                </div>
            }

            @await Html.PartialAsync("_PrintHeader")

            @if (!cashAccounts.Any())
            {
                <div class="card">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-wallet fa-3x text-muted mb-3"></i>
                        <h5 class="text-muted">No Cash/Bank Accounts Yet</h5>
                        <p class="text-muted">
                            Create your first cash or bank account to start recording transactions.
                        </p>
                        <button class="btn btn-primary"
                                data-bs-toggle="modal"
                                data-bs-target="#addAccountModal">
                            <i class="fas fa-plus me-1"></i> Create Cash/Bank Account
                        </button>
                    </div>
                </div>
            }
            else
            {
                @* Cash Accounts Summary Cards *@
                <div class="row g-3 mb-4 d-print-none">
                    @if (ViewBag.CashSummary != null)
                    {
                        var icons = new[] {
                            "fas fa-coins", "fas fa-university",
                            "fas fa-mobile-alt", "fas fa-wallet" };
                        var colors = new[] { "blue", "green", "orange", "purple" };
                        int idx = 0;
                        foreach (var item in ViewBag.CashSummary)
                        {
                            var bal = (decimal)item.Balance;
                            var accId = (int)item.AccountId;
                            <div class="col-sm-6 col-xl-3">
                                <a href="/Accounting/Cashbook?cashAccountId=@accId"
                                   class="text-decoration-none">
                                    <div class="stat-card @(selectedAccount?.Id == accId ? "border border-primary" : "")">
                                        <div class="stat-icon @colors[idx % colors.Length]">
                                            <i class="@icons[idx % icons.Length]"></i>
                                        </div>
                                        <div>
                                            <div class="stat-value" style="font-size:1.1rem;">
                                                KES @bal.ToString("N0")
                                            </div>
                                            <div class="stat-label">@item.AccountName</div>
                                            @if (item.BankName != null)
                                            {
                                                <small class="text-muted d-block">
                                                    @item.BankName
                                                    @(item.AccountNumber != null ? $"— {item.AccountNumber}" : "")
                                                </small>
                                            }
                                            <small class="text-@(bal >= 0 ? "success" : "danger")">
                                                Balance
                                            </small>
                                        </div>
                                    </div>
                                </a>
                            </div>
                            idx++;
                        }
                    }
                </div>

                @* Account Tabs *@
                <div class="d-print-none mb-3">
                    @foreach (var acc in cashAccounts)
                    {
                        <a href="/Accounting/Cashbook?cashAccountId=@acc.Id"
                           class="btn btn-sm me-1 @(selectedAccount?.Id == acc.Id ? "btn-primary" : "btn-outline-primary")">
                            <i class="fas fa-wallet me-1"></i>
                            @acc.Name
                        </a>
                    }
                </div>

                @if (selectedAccount != null)
                {
                    @* Filters *@
                    <div class="card mb-4 d-print-none">
                        <div class="card-body p-3">
                            <div class="row g-2 align-items-end">
                                <div class="col-md-3">
                                    <label class="form-label small fw-bold">From</label>
                                    <input type="date" id="fromDate"
                                           class="form-control"
                                           value="@((DateTime)ViewBag.FromDate).ToString("yyyy-MM-dd")" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small fw-bold">To</label>
                                    <input type="date" id="toDate"
                                           class="form-control"
                                           value="@((DateTime)ViewBag.ToDate).ToString("yyyy-MM-dd")" />
                                </div>
                                <div class="col-md-3">
                                    <button class="btn btn-primary w-100"
                                            onclick="applyFilter()">
                                        <i class="fas fa-search me-1"></i> Filter
                                    </button>
                                </div>
                                <div class="col-md-3">
                                    <a href="/Accounting/GeneralLedger?accountId=@selectedAccount.Id"
                                       class="btn btn-outline-secondary w-100">
                                        <i class="fas fa-list-alt me-1"></i> View in GL
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* Summary Stats *@
                    <div class="row g-3 mb-4">
                        <div class="col-sm-3">
                            <div class="stat-card">
                                <div class="stat-icon blue">
                                    <i class="fas fa-wallet"></i>
                                </div>
                                <div>
                                    <div class="stat-value">
                                        KES @(((decimal)ViewBag.OpeningBalance).ToString("N0"))
                                    </div>
                                    <div class="stat-label">Opening Balance</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-3">
                            <div class="stat-card">
                                <div class="stat-icon green">
                                    <i class="fas fa-arrow-down"></i>
                                </div>
                                <div>
                                    <div class="stat-value">
                                        KES @(((decimal)ViewBag.TotalReceipts).ToString("N0"))
                                    </div>
                                    <div class="stat-label">Total Receipts</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-3">
                            <div class="stat-card">
                                <div class="stat-icon orange">
                                    <i class="fas fa-arrow-up"></i>
                                </div>
                                <div>
                                    <div class="stat-value">
                                        KES @(((decimal)ViewBag.TotalPayments).ToString("N0"))
                                    </div>
                                    <div class="stat-label">Total Payments</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-3">
                            <div class="stat-card">
                                <div class="stat-icon @(((decimal)ViewBag.ClosingBalance) >= 0 ? "green" : "purple")">
                                    <i class="fas fa-balance-scale"></i>
                                </div>
                                <div>
                                    <div class="stat-value @(((decimal)ViewBag.ClosingBalance) < 0 ? "text-danger" : "")">
                                        KES @(((decimal)ViewBag.ClosingBalance).ToString("N0"))
                                    </div>
                                    <div class="stat-label">Closing Balance</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* Cashbook Table *@
                    <div class="card">
                        <div class="card-header d-flex justify-content-between">
                            <span>
                                <i class="fas fa-book me-2 text-primary"></i>
                                <strong>@selectedAccount.Name Cashbook</strong>
                                <span class="badge bg-primary ms-2">
                                    @Model.Count entries
                                </span>
                            </span>
                            <button class="btn btn-primary btn-sm d-print-none"
                                    data-bs-toggle="modal"
                                    data-bs-target="#addEntryModal">
                                <i class="fas fa-plus me-1"></i> Add Entry
                            </button>
                        </div>
                        @if (!Model.Any())
                        {
                            <div class="card-body text-center py-5">
                                <i class="fas fa-money-bill-wave fa-3x text-muted mb-3"></i>
                                <h5 class="text-muted">No Entries Yet</h5>
                                <p class="text-muted">
                                    Click <strong>"New Entry"</strong> to record
                                    a receipt or payment for @selectedAccount.Name.
                                </p>
                                <button class="btn btn-primary"
                                        data-bs-toggle="modal"
                                        data-bs-target="#addEntryModal">
                                    <i class="fas fa-plus me-1"></i>
                                    Record First Entry
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-bordered mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Date</th>
                                            <th>Ref No.</th>
                                            <th>Description</th>
                                            <th>Payee/Payer</th>
                                            <th>Account</th>
                                            <th class="text-end text-success">
                                                Receipts (Dr)
                                            </th>
                                            <th class="text-end text-danger">
                                                Payments (Cr)
                                            </th>
                                            <th class="text-end">Balance</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr class="table-light">
                                            <td colspan="7" class="fw-bold">
                                                Opening Balance
                                            </td>
                                            <td class="text-end fw-bold">
                                                KES @(((decimal)ViewBag.OpeningBalance).ToString("N2"))
                                            </td>
                                        </tr>
                                        @{
                                            decimal runningBal = (decimal)ViewBag.OpeningBalance;
                                        }
                                        @foreach (var entry in Model)
                                        {
                                            if (entry.EntryType == CashbookEntryType.Receipt)
                                                runningBal += entry.Amount;
                                            else
                                                runningBal -= entry.Amount;

                                            <tr class="@(entry.EntryType == CashbookEntryType.Receipt ? "" : "table-light")">
                                                <td>
                                                    @entry.EntryDate.ToString("dd MMM yyyy")
                                                </td>
                                                <td>
                                                    <span class="badge @(entry.EntryType == CashbookEntryType.Receipt ? "bg-success" : "bg-danger")">
                                                        @entry.EntryNumber
                                                    </span>
                                                </td>
                                                <td>@entry.Description</td>
                                                <td class="text-muted small">
                                                    @(entry.PayeePayer ?? "-")
                                                </td>
                                                <td class="small">
                                                    @entry.ContraAccount.Code —
                                                    @entry.ContraAccount.Name
                                                </td>
                                                <td class="text-end text-success fw-bold">
                                                    @if (entry.EntryType == CashbookEntryType.Receipt)
                                                    {
                                                        @entry.Amount.ToString("N2")
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">—</span>
                                                    }
                                                </td>
                                                <td class="text-end text-danger fw-bold">
                                                    @if (entry.EntryType == CashbookEntryType.Payment)
                                                    {
                                                        @entry.Amount.ToString("N2")
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">—</span>
                                                    }
                                                </td>
                                                <td class="text-end fw-bold @(runningBal < 0 ? "text-danger" : "text-primary")">
                                                    @runningBal.ToString("N2")
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot class="table-light">
                                        <tr>
                                            <td colspan="5" class="fw-bold text-end">
                                                TOTALS:
                                            </td>
                                            <td class="text-end fw-bold text-success">
                                                KES @(((decimal)ViewBag.TotalReceipts).ToString("N2"))
                                            </td>
                                            <td class="text-end fw-bold text-danger">
                                                KES @(((decimal)ViewBag.TotalPayments).ToString("N2"))
                                            </td>
                                            <td class="text-end fw-bold text-primary">
                                                KES @(((decimal)ViewBag.ClosingBalance).ToString("N2"))
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                            <div class="card-footer d-print-block text-muted small">
                                @(school?.Name ?? "") — @selectedAccount.Name Cashbook |
                                Generated: @DateTime.Now.ToString("dd MMM yyyy HH:mm") |
                                Prepared by: @User.Identity?.Name
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>
</div>

@* ADD CASH/BANK ACCOUNT MODAL *@
<div class="modal fade" id="addAccountModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-plus me-2"></i>New Cash/Bank Account
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateCashAccount" asp-controller="Accounting" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            Account Name <span class="text-danger">*</span>
                        </label>
                        <input type="text" name="name" class="form-control"
                               placeholder="e.g. Cash in Hand, M-Pesa, Family Bank" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Bank Name (if applicable)</label>
                        <input type="text" name="bankName" class="form-control"
                               placeholder="e.g. Family Bank" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Account Number (if applicable)</label>
                        <input type="text" name="accountNumber" class="form-control"
                               placeholder="e.g. 0123456789" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Opening Balance (KES)</label>
                        <input type="number" name="openingBalance" class="form-control"
                               placeholder="0.00" step="0.01" value="0" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i>Create Account
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
<div class="modal fade" id="transferModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-exchange-alt me-2"></i>Transfer Funds
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="TransferFunds" asp-controller="Accounting" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Date <span class="text-danger">*</span></label>
                        <input type="date" name="transferDate" class="form-control"
                               value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">From Account <span class="text-danger">*</span></label>
                        <select name="fromAccountId" class="form-control" required>
                            <option value="">-- Select --</option>
                            @foreach (var acc in cashAccounts)
                            {
                                <option value="@acc.Id">@acc.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">To Account <span class="text-danger">*</span></label>
                        <select name="toAccountId" class="form-control" required>
                            <option value="">-- Select --</option>
                            @foreach (var acc in cashAccounts)
                            {
                                <option value="@acc.Id">@acc.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Amount (KES) <span class="text-danger">*</span></label>
                        <input type="number" name="amount" class="form-control"
                               placeholder="0.00" min="0.01" step="0.01" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Description</label>
                        <input type="text" name="description" class="form-control"
                               placeholder="e.g. Restocking petty cash" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-info">
                        <i class="fas fa-exchange-alt me-1"></i>Transfer
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (selectedAccount != null)
{
    @* NEW ENTRY MODAL *@
    <div class="modal fade" id="addEntryModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-plus me-2"></i>
                        New Cashbook Entry — @selectedAccount.Name
                    </h5>
                    <button type="button" class="btn-close"
                            data-bs-dismiss="modal"></button>
                </div>
                <form asp-action="CreateCashbookEntry"
                      asp-controller="Accounting" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="cashAccountId" value="@selectedAccount.Id" />
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label fw-bold">
                                    Date <span class="text-danger">*</span>
                                </label>
                                <input type="date" name="entryDate"
                                       class="form-control"
                                       value="@DateTime.Today.ToString("yyyy-MM-dd")"
                                       required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">
                                    Entry Type <span class="text-danger">*</span>
                                </label>
                                <select name="entryType" class="form-control"
                                        id="entryTypeSelect"
                                        onchange="updateContraLabel()"
                                        required>
                                    <option value="1">Receipt (Money IN ↓)</option>
                                    <option value="2">Payment (Money OUT ↑)</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">
                                    Amount (KES) <span class="text-danger">*</span>
                                </label>
                                <input type="number" name="amount"
                                       class="form-control"
                                       placeholder="0.00" min="0.01"
                                       step="0.01" required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold" id="contraLabel">
                                    Income Account (Credit)
                                    <span class="text-danger">*</span>
                                </label>
                                <select name="accountId" class="form-control" required>
                                    <option value="">-- Select Account --</option>
                                    @{
                                        var accounts = ViewBag.Accounts as
                                            List<Account> ?? new List<Account>();
                                        var incomeAccounts = accounts
                                            .Where(a => a.AccountType == AccountType.Income).ToList();
                                        var expenseAccounts = accounts
                                            .Where(a => a.AccountType == AccountType.Expense).ToList();
                                        var otherAccounts = accounts
                                            .Where(a => a.AccountType != AccountType.Income &&
                                                        a.AccountType != AccountType.Expense &&
                                                        a.Category != AccountCategory.BankCash)
                                            .ToList();
                                    }
                                    <optgroup label="── INCOME ACCOUNTS ──">
                                        @foreach (var acc in incomeAccounts)
                                        {
                                            <option value="@acc.Id">@acc.Code — @acc.Name</option>
                                        }
                                    </optgroup>
                                    <optgroup label="── EXPENSE ACCOUNTS ──">
                                        @foreach (var acc in expenseAccounts)
                                        {
                                            <option value="@acc.Id">@acc.Code — @acc.Name</option>
                                        }
                                    </optgroup>
                                    <optgroup label="── OTHER ACCOUNTS ──">
                                        @foreach (var acc in otherAccounts)
                                        {
                                            <option value="@acc.Id">@acc.Code — @acc.Name</option>
                                        }
                                    </optgroup>
                                </select>
                                <small class="text-muted" id="contraHint">
                                    For receipts: select income account
                                    (e.g. Tuition Fees). Journal entry:
                                    Dr Cash / Cr Income
                                </small>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">Payee / Payer</label>
                                <input type="text" name="payeePayer"
                                       class="form-control"
                                       placeholder="e.g. John Kamau, KP&LC" />
                            </div>

                            <div class="col-md-8">
                                <label class="form-label fw-bold">
                                    Description <span class="text-danger">*</span>
                                </label>
                                <input type="text" name="description"
                                       class="form-control"
                                       placeholder="e.g. Tuition fee payment — Term 1 2025"
                                       required />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-bold">Reference No.</label>
                                <input type="text" name="reference"
                                       class="form-control"
                                       placeholder="Cheque/Receipt/M-Pesa code" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">Term (optional)</label>
                                <select name="academicTermId" class="form-control">
                                    <option value="">None</option>
                                    @foreach (var term in ViewBag.Terms)
                                    {
                                        <option value="@term.Id">
                                            @term.AcademicYear.Name - @term.Name
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="col-12">
                                <div class="alert alert-info small mb-0" id="journalPreview">
                                    <i class="fas fa-info-circle me-2"></i>
                                    <strong>Journal Entry Preview:</strong>
                                    Dr @selectedAccount.Name / Cr Income Account (auto-posted)
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary"
                                data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i>Save Entry
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
    function applyFilter() {
        const from = document.getElementById('fromDate').value;
        const to = document.getElementById('toDate').value;
        window.location =
            '/Accounting/Cashbook?cashAccountId=@(selectedAccount?.Id ?? 0)&fromDate='
            + from + '&toDate=' + to;
    }

    function updateContraLabel() {
        const type = document.getElementById('entryTypeSelect').value;
        const label = document.getElementById('contraLabel');
        const hint = document.getElementById('contraHint');
        const preview = document.getElementById('journalPreview');
        const accName = '@(selectedAccount?.Name ?? "Cash")';

        if (type == '1') {
            label.innerHTML = 'Income Account (Credit) <span class="text-danger">*</span>';
            hint.textContent = 'For receipts: select income account (e.g. Tuition Fees). Journal: Dr Cash / Cr Income';
            preview.innerHTML = '<i class="fas fa-info-circle me-2"></i><strong>Journal Entry Preview:</strong> Dr ' + accName + ' / Cr Selected Income Account (auto-posted)';
        } else {
            label.innerHTML = 'Expense Account (Debit) <span class="text-danger">*</span>';
            hint.textContent = 'For payments: select expense account (e.g. Electricity). Journal: Dr Expense / Cr Cash';
            preview.innerHTML = '<i class="fas fa-info-circle me-2"></i><strong>Journal Entry Preview:</strong> Dr Selected Expense Account / Cr ' + accName + ' (auto-posted)';
        }
    }
</script>
}