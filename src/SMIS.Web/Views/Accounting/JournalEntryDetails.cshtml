@model SMIS.Domain.Entities.Accounting.JournalEntry
@using SMIS.Domain.Entities.Accounting
@{
    ViewData["Title"] = "Journal Entry Details";
    ViewBag.ReportTitle = $"Journal Entry — {Model.EntryNumber}";
}
<div class="app-wrapper">
    @await Html.PartialAsync("_Sidebar")
        
    <div class="main-content">
        <header class="top-header">
            <div class="header-left">
                <span class="page-title">
                    <i class="fas fa-book me-2 text-primary"></i>
                    @Model.EntryNumber
                </span>
            </div>
            <div class="header-right">
                <button onclick="window.print()"
                        class="btn btn-outline-primary btn-sm me-2">
                    <i class="fas fa-print me-1"></i> Print
                </button>
                @if (Model.Status == JournalEntryStatus.Draft)
                {
                    <form asp-action="PostJournalEntry"
                          asp-controller="Accounting" method="post"
                          class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-success btn-sm me-2"
                                onclick="return confirm('Post this journal entry? This cannot be undone.')">
                            <i class="fas fa-check me-1"></i> Post Entry
                        </button>
                    </form>
                }
                <a href="/Accounting/JournalEntries"
                   class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-arrow-left me-1"></i> Back
                </a>
                <div class="user-avatar ms-2">
                    @(User.Identity?.Name?.Substring(0,1).ToUpper() ?? "A")
                </div>
                <form asp-action="Logout" asp-controller="Account"
                      method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="header-btn" title="Logout">
                        <i class="fas fa-sign-out-alt"></i>
                    </button>
                </form>
            </div>
        </header>

        <div class="content-area">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-4">
                    <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close"
                            data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mb-4">
                    <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close"
                            data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between">
                    <span>
                        <strong>@Model.EntryNumber</strong>
                    </span>
                    @switch (Model.Status)
                    {
                        case JournalEntryStatus.Posted:
                            <span class="badge bg-success fs-6">POSTED</span>
                            break;
                        case JournalEntryStatus.Draft:
                            <span class="badge bg-warning text-dark fs-6">DRAFT</span>
                            break;
                        case JournalEntryStatus.Reversed:
                            <span class="badge bg-secondary fs-6">REVERSED</span>
                            break;
                    }
                </div>
                <div class="card-body p-4">
                    <div class="row">
                        <div class="col-md-6">
                            <table class="table table-sm mb-0">
                                <tr>
                                    <td class="fw-bold text-muted">
                                        Entry No:
                                    </td>
                                    <td>@Model.EntryNumber</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold text-muted">Date:</td>
                                    <td>@Model.EntryDate.ToString("dd MMM yyyy")</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold text-muted">Type:</td>
                                    <td>@Model.EntryType</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold text-muted">
                                        Reference:
                                    </td>
                                    <td>@(Model.Reference ?? "-")</td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <table class="table table-sm mb-0">
                                <tr>
                                    <td class="fw-bold text-muted">
                                        Description:
                                    </td>
                                    <td>@Model.Description</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold text-muted">
                                        Created by:
                                    </td>
                                    <td>@Model.CreatedBy</td>
                                </tr>
                                @if (Model.PostedBy != null)
                                {
                                    <tr>
                                        <td class="fw-bold text-muted">
                                            Posted by:
                                        </td>
                                        <td>@Model.PostedBy</td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold text-muted">
                                            Posted at:
                                        </td>
                                        <td>@Model.PostedAt?.ToString("dd MMM yyyy HH:mm")</td>
                                    </tr>
                                }
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <strong>Journal Lines</strong>
                </div>
                <div class="table-responsive">
                    <table class="table table-bordered mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Account Code</th>
                                <th>Account Name</th>
                                <th>Narration</th>
                                <th class="text-end">Debit (KES)</th>
                                <th class="text-end">Credit (KES)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in
                                Model.Lines.OrderBy(l => l.LineNumber))
                            {
                                <tr>
                                    <td>@line.LineNumber</td>
                                    <td>
                                        <span class="badge bg-light text-dark">
                                            @line.Account.Code
                                        </span>
                                    </td>
                                    <td>@line.Account.Name</td>
                                    <td class="text-muted small">
                                        @(line.Narration ?? "-")
                                    </td>
                                    <td class="text-end">
                                        @if (line.DebitAmount > 0)
                                        {
                                            <strong class="text-primary">
                                                @line.DebitAmount.ToString("N2")
                                            </strong>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (line.CreditAmount > 0)
                                        {
                                            <strong class="text-success">
                                                @line.CreditAmount.ToString("N2")
                                            </strong>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="4" class="fw-bold text-end">
                                    TOTALS:
                                </td>
                                <td class="text-end fw-bold text-primary">
                                    KES @Model.Lines.Sum(l => l.DebitAmount).ToString("N2")
                                </td>
                                <td class="text-end fw-bold text-success">
                                    KES @Model.Lines.Sum(l => l.CreditAmount).ToString("N2")
                                </td>
                            </tr>
                            <tr>
                                <td colspan="6" class="text-center">
                                    @if (Model.Lines.Sum(l => l.DebitAmount) ==
                                         Model.Lines.Sum(l => l.CreditAmount))
                                    {
                                        <span class="badge bg-success">
                                            ✓ BALANCED
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            ✗ NOT BALANCED
                                        </span>
                                    }
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>