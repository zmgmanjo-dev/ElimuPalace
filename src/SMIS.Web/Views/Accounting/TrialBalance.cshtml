@model List<SMIS.Domain.Entities.Accounting.Account>
@using SMIS.Domain.Entities.Accounting
@{
    ViewData["Title"] = "Trial Balance";
    var school = ViewBag.School as SMIS.Domain.Entities.School.SchoolProfile;
    var asAt = (DateTime)ViewBag.AsAt;
    var showSubAccounts = (bool)ViewBag.ShowSubAccounts;
    var ledgerBalances = ViewBag.LedgerBalances as
        Dictionary<int, (decimal Debit, decimal Credit)>
        ?? new Dictionary<int, (decimal, decimal)>();
    ViewBag.ReportTitle = "Trial Balance";
    ViewBag.ReportSubtitle = $"As at {asAt:dd MMM yyyy}";
}

<div class="app-wrapper">
    @await Html.PartialAsync("_Sidebar")
        
    <div class="main-content">
        <header class="top-header d-print-none">
            <div class="header-left">
                <span class="page-title">
                    <i class="fas fa-balance-scale me-2 text-primary"></i>
                    Trial Balance
                </span>
            </div>
            <div class="header-right">
                <button onclick="window.print()"
                        class="btn btn-success btn-sm me-2">
                    <i class="fas fa-print me-1"></i> Print
                </button>
                <div class="user-avatar ms-2">
                    @(User.Identity?.Name?.Substring(0,1).ToUpper() ?? "A")
                </div>
                <form asp-action="Logout" asp-controller="Account"
                      method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="header-btn" title="Logout">
                        <i class="fas fa-sign-out-alt"></i>
                    </button>
                </form>
            </div>
        </header>

        <div class="content-area">
            @await Html.PartialAsync("_PrintHeader")

            @* Filter Controls *@
            <div class="card mb-4 d-print-none">
                <div class="card-body p-3">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label small fw-bold">
                                As at Date
                            </label>
                            <input type="date" id="asAtDate"
                                   class="form-control"
                                   value="@asAt.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold d-block">
                                View Options
                            </label>
                            <div class="form-check form-switch mt-1">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="showSubAccountsCheck"
                                       @(showSubAccounts ? "checked" : "")
                                       onchange="applyFilter()" />
                                <label class="form-check-label"
                                       for="showSubAccountsCheck">
                                    Show sub-accounts only
                                    (uncheck to include header accounts)
                                </label>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-primary w-100"
                                    onclick="applyFilter()">
                                <i class="fas fa-search me-1"></i> View
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header text-center">
                    <h5 class="fw-bold mb-0">
                        @(school?.Name ?? "School") — TRIAL BALANCE
                    </h5>
                    <p class="text-muted mb-0 small">
                        As at @asAt.ToString("dd MMMM yyyy")
                        @if (!showSubAccounts)
                        {
                            <span class="badge bg-info text-dark ms-2">
                                Including Header Accounts
                            </span>
                        }
                    </p>
                </div>
                <div class="table-responsive">
                    <table class="table table-bordered mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Code</th>
                                <th>Account Name</th>
                                <th>Type</th>
                                <th class="text-end">Debit (KES)</th>
                                <th class="text-end">Credit (KES)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var acc in Model.OrderBy(a => a.Code))
                            {
                                var bal = ledgerBalances.GetValueOrDefault(
                                    acc.Id, (0, 0));
                                var fromDate = new DateTime(
                                    DateTime.Today.Year, 1, 1)
                                    .ToString("yyyy-MM-dd");
                                var toDate = asAt.ToString("yyyy-MM-dd");
                                <tr class="@(!acc.AllowDirectEntry ? "table-light fw-bold" : "")">
                                    <td>
                                        @if (acc.AllowDirectEntry)
                                        {
                                            <a href="/Accounting/GeneralLedger?accountId=@acc.Id&fromDate=@fromDate&toDate=@toDate"
                                               class="badge bg-light text-dark text-decoration-none"
                                               title="View General Ledger for @acc.Name">
                                                @acc.Code
                                                <i class="fas fa-external-link-alt ms-1" style="font-size:9px;"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @acc.Code
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (acc.AllowDirectEntry)
                                        {
                                            <a href="/Accounting/GeneralLedger?accountId=@acc.Id&fromDate=@fromDate&toDate=@toDate"
                                               class="text-decoration-none text-dark">
                                                @acc.Name
                                            </a>
                                        }
                                        else
                                        {
                                            <strong>@acc.Name</strong>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark small">
                                            @acc.AccountType
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        @if (bal.Debit > 0)
                                        {
                                            @if (acc.AllowDirectEntry)
                                            {
                                                <a href="/Accounting/GeneralLedger?accountId=@acc.Id&fromDate=@fromDate&toDate=@toDate"
                                                   class="text-decoration-none">
                                                    @bal.Debit.ToString("N2")
                                                </a>
                                            }
                                            else
                                            {
                                                @bal.Debit.ToString("N2")
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (bal.Credit > 0)
                                        {
                                            @if (acc.AllowDirectEntry)
                                            {
                                                <a href="/Accounting/GeneralLedger?accountId=@acc.Id&fromDate=@fromDate&toDate=@toDate"
                                                   class="text-decoration-none">
                                                    @bal.Credit.ToString("N2")
                                                </a>
                                            }
                                            else
                                            {
                                                @bal.Credit.ToString("N2")
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="3" class="fw-bold text-end">
                                    TOTALS:
                                </td>
                                <td class="text-end fw-bold text-primary fs-6">
                                    KES @(((decimal)ViewBag.TotalDebits).ToString("N2"))
                                </td>
                                <td class="text-end fw-bold text-success fs-6">
                                    KES @(((decimal)ViewBag.TotalCredits).ToString("N2"))
                                </td>
                            </tr>
                            <tr>
                                <td colspan="5" class="text-center py-2">
                                    @if ((decimal)ViewBag.TotalDebits ==
                                         (decimal)ViewBag.TotalCredits)
                                    {
                                        <span class="badge bg-success fs-6 px-4">
                                            ✓ BALANCED
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger fs-6 px-4">
                                            ✗ NOT BALANCED — Difference: KES
                                            @(Math.Abs(
                                                (decimal)ViewBag.TotalDebits -
                                                (decimal)ViewBag.TotalCredits
                                            ).ToString("N2"))
                                        </span>
                                    }
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <div class="card-footer d-print-block text-muted small text-center">
                    @(school?.Name ?? "") |
                    Generated: @DateTime.Now.ToString("dd MMM yyyy HH:mm")
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function applyFilter() {
        const date = document.getElementById('asAtDate').value;
        const showSub = document.getElementById('showSubAccountsCheck').checked;
        window.location = '/Accounting/TrialBalance?asAt=' + date +
            '&showSubAccounts=' + showSub;
    }
</script>
}