@model List<SMIS.Domain.Entities.Accounting.JournalEntryLine>
@using SMIS.Domain.Entities.Accounting
@{
    ViewData["Title"] = "General Ledger";
    var selectedAccount = ViewBag.SelectedAccount as Account;
    var school = ViewBag.School as SMIS.Domain.Entities.School.SchoolProfile;
    ViewBag.ReportTitle = "General Ledger";
    ViewBag.ReportSubtitle = selectedAccount != null
        ? $"Account: {selectedAccount.Code} - {selectedAccount.Name}" : "";
}

<div class="app-wrapper">
    @await Html.PartialAsync("_Sidebar")
        
    <div class="main-content">
        <header class="top-header d-print-none">
            <div class="header-left">
                <span class="page-title">
                    <i class="fas fa-list-alt me-2 text-primary"></i>
                    General Ledger
                </span>
            </div>
            <div class="header-right">
                @if (selectedAccount != null)
                {
                    <button onclick="window.print()"
                            class="btn btn-success btn-sm me-2">
                        <i class="fas fa-print me-1"></i> Print
                    </button>
                }
                <div class="user-avatar ms-2">
                    @(User.Identity?.Name?.Substring(0,1).ToUpper() ?? "A")
                </div>
                <form asp-action="Logout" asp-controller="Account"
                      method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="header-btn" title="Logout">
                        <i class="fas fa-sign-out-alt"></i>
                    </button>
                </form>
            </div>
        </header>

        <div class="content-area">
            @await Html.PartialAsync("_PrintHeader")

            <div class="card mb-4 d-print-none">
                <div class="card-body p-3">
                    <div class="row g-2">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">
                                Account
                            </label>
                            <select id="accountSelect" class="form-control">
                                <option value="">-- Select Account --</option>
                                @foreach (var acc in ViewBag.Accounts)
                                {
                                    if (ViewBag.AccountId != null &&
                                        ViewBag.AccountId == acc.Id)
                                    {
                                        <option value="@acc.Id" selected>
                                            @acc.Code - @acc.Name
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@acc.Id">
                                            @acc.Code - @acc.Name
                                        </option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-bold">From</label>
                            <input type="date" id="fromDate"
                                   class="form-control"
                                   value="@((DateTime)ViewBag.FromDate).ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-bold">To</label>
                            <input type="date" id="toDate"
                                   class="form-control"
                                   value="@((DateTime)ViewBag.ToDate).ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button class="btn btn-primary w-100"
                                    onclick="applyFilter()">
                                <i class="fas fa-search me-1"></i> View
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            @if (selectedAccount == null)
            {
                <div class="card">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-list-alt fa-3x text-muted mb-3"></i>
                        <h5 class="text-muted">Select an Account</h5>
                        <p class="text-muted">
                            Choose an account above to view its ledger.
                        </p>
                    </div>
                </div>
            }
            else
            {
                <div class="card mb-4">
                    <div class="card-body p-3">
                        <div class="row">
                            <div class="col-md-6">
                                <h5 class="fw-bold mb-0">
                                    @selectedAccount.Code — @selectedAccount.Name
                                </h5>
                                <span class="badge bg-primary">
                                    @selectedAccount.AccountType
                                </span>
                                <span class="badge bg-light text-dark ms-1">
                                    Normal Balance:
                                    @selectedAccount.NormalBalance
                                </span>
                            </div>
                            <div class="col-md-6 text-end">
                                <strong>Period:</strong>
                                @((DateTime)ViewBag.FromDate).ToString("dd MMM yyyy")
                                — @((DateTime)ViewBag.ToDate).ToString("dd MMM yyyy")
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <strong>Ledger Transactions</strong>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-bordered mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Date</th>
                                    <th>Entry No.</th>
                                    <th>Description</th>
                                    <th>Narration</th>
                                    <th class="text-end">Debit</th>
                                    <th class="text-end">Credit</th>
                                    <th class="text-end">Balance</th>
                                </tr>
                            </thead>
                            <tbody>
                                @* Opening Balance *@
                                <tr class="table-light">
                                    <td colspan="4">
                                        <strong>Opening Balance</strong>
                                    </td>
                                    <td class="text-end">
                                        @if (selectedAccount.NormalBalance ==
                                            BalanceSide.Debit &&
                                            selectedAccount.OpeningBalance > 0)
                                        {
                                            @selectedAccount.OpeningBalance.ToString("N2")
                                        }
                                        else
                                        {
                                            <span>—</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (selectedAccount.NormalBalance ==
                                            BalanceSide.Credit &&
                                            selectedAccount.OpeningBalance > 0)
                                        {
                                            @selectedAccount.OpeningBalance.ToString("N2")
                                        }
                                        else
                                        {
                                            <span>—</span>
                                        }
                                    </td>
                                    <td class="text-end fw-bold">
                                        @selectedAccount.OpeningBalance.ToString("N2")
                                    </td>
                                </tr>

                                @{
                                    decimal balance = (decimal)ViewBag.OpeningBalance;
                                }
                                @foreach (var line in Model)
                                {
                                    if (selectedAccount.NormalBalance ==
                                        BalanceSide.Debit)
                                        balance += line.DebitAmount -
                                            line.CreditAmount;
                                    else
                                        balance += line.CreditAmount -
                                            line.DebitAmount;

                                    <tr>
                                        <td>
    @line.JournalEntry.EntryDate.ToString("dd MMM yyyy")
                                        </td>
                                        <td>
                                            <a href="/Accounting/JournalEntryDetails/@line.JournalEntryId">
                                                @line.JournalEntry.EntryNumber
                                            </a>
                                        </td>
                                        <td>@line.JournalEntry.Description</td>
                                        <td class="text-muted small">
                                            @(line.Narration ?? "-")
                                        </td>
                                        <td class="text-end">
                                            @if (line.DebitAmount > 0)
                                            {
                                                @line.DebitAmount.ToString("N2")
                                            }
                                            else
                                            {
                                                <span>—</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (line.CreditAmount > 0)
                                            {
                                                @line.CreditAmount.ToString("N2")
                                            }
                                            else
                                            {
                                                <span>—</span>
                                            }
                                        </td>
                                        <td class="text-end fw-bold @(balance < 0 ? "text-danger" : "")">
                                            @balance.ToString("N2")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <td colspan="4" class="fw-bold text-end">
                                        CLOSING BALANCE:
                                    </td>
                                    <td class="text-end fw-bold">
                                        KES @Model.Sum(l => l.DebitAmount).ToString("N2")
                                    </td>
                                    <td class="text-end fw-bold">
                                        KES @Model.Sum(l => l.CreditAmount).ToString("N2")
                                    </td>
                                    <td class="text-end fw-bold text-primary">
                                        @{
                                            decimal closingBalance =
                                                (decimal)ViewBag.OpeningBalance;
                                            if (selectedAccount.NormalBalance ==
                                                BalanceSide.Debit)
                                                closingBalance +=
                                                    Model.Sum(l => l.DebitAmount) -
                                                    Model.Sum(l => l.CreditAmount);
                                            else
                                                closingBalance +=
                                                    Model.Sum(l => l.CreditAmount) -
                                                    Model.Sum(l => l.DebitAmount);
                                        }
                                        KES @closingBalance.ToString("N2")
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    function applyFilter() {
        const accId = document.getElementById('accountSelect').value;
        const from = document.getElementById('fromDate').value;
        const to = document.getElementById('toDate').value;
        if (!accId) { alert('Please select an account.'); return; }
        window.location = '/Accounting/GeneralLedger?accountId=' +
            accId + '&fromDate=' + from + '&toDate=' + to;
    }
</script>
}