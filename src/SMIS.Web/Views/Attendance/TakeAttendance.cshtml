@model List<SMIS.Domain.Entities.Students.Student>
@using SMIS.Domain.Entities.Academic
@{
    ViewData["Title"] = "Take Attendance";
    var classLevel = ViewBag.ClassLevel as SMIS.Domain.Entities.School.ClassLevel;
    var attendanceDate = (DateTime)ViewBag.AttendanceDate;
    var currentTerm = ViewBag.CurrentTerm as SMIS.Domain.Entities.School.AcademicTerm;
    var existingAttendance = ViewBag.ExistingAttendance as
        List<AttendanceRecord> ?? new List<AttendanceRecord>();
}

<div class="app-wrapper">
    @await Html.PartialAsync("_Sidebar")
        
    <div class="main-content">
        <header class="top-header">
            <div class="header-left">
                <span class="page-title">
                    <i class="fas fa-clipboard-check me-2 text-primary"></i>
                    Attendance — @classLevel?.Name
                    — @attendanceDate.ToString("dd MMM yyyy")
                </span>
            </div>
            <div class="header-right">
                <a href="/Attendance" class="btn btn-outline-secondary btn-sm me-2">
                    <i class="fas fa-arrow-left me-1"></i> Back
                </a>
                <div class="user-avatar ms-2">
                    @(User.Identity?.Name?.Substring(0,1).ToUpper() ?? "A")
                </div>
                <form asp-action="Logout" asp-controller="Account"
                      method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="header-btn" title="Logout">
                        <i class="fas fa-sign-out-alt"></i>
                    </button>
                </form>
            </div>
        </header>

        <div class="content-area">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-4">
                    <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close"
                            data-bs-dismiss="alert"></button>
                </div>
            }

            @* Date Navigation *@
            <div class="card mb-4">
                <div class="card-body p-3">
                    <div class="row align-items-center">
                        <div class="col-md-4">
                            <a href="/Attendance/TakeAttendance?classLevelId=@classLevel?.Id&date=@attendanceDate.AddDays(-1):yyyy-MM-dd"
                               class="btn btn-outline-secondary btn-sm">
                                <i class="fas fa-chevron-left"></i> Previous Day
                            </a>
                            <a href="/Attendance/TakeAttendance?classLevelId=@classLevel?.Id&date=@attendanceDate.AddDays(1).ToString("yyyy-MM-dd")"
                               class="btn btn-outline-secondary btn-sm ms-2">
                                Next Day <i class="fas fa-chevron-right"></i>
                            </a>
                        </div>
                        <div class="col-md-4 text-center">
                            <form method="get"
                                  action="/Attendance/TakeAttendance"
                                  class="d-inline-flex gap-2">
                                <input type="hidden" name="classLevelId"
                                       value="@classLevel?.Id" />
                                <input type="date" name="date" class="form-control form-control-sm"
                                       value="@attendanceDate.ToString("yyyy-MM-dd")"
                                       onchange="this.form.submit()" />
                            </form>
                        </div>
                        <div class="col-md-4 text-end">
                            @if (ViewBag.Streams != null)
                            {
                                @foreach (var stream in ViewBag.Streams)
                                {
                                    <a href="/Attendance/TakeAttendance?classLevelId=@classLevel?.Id&classStreamId=@stream.Id&date=@attendanceDate.ToString("yyyy-MM-dd")"
                                       class="btn btn-sm @(ViewBag.ClassStreamId == stream.Id ? "btn-primary" : "btn-outline-primary") me-1">
                                        @stream.Name
                                    </a>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>

            @if (!Model.Any())
            {
                <div class="card">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-users fa-3x text-muted mb-3"></i>
                        <h5 class="text-muted">No Students Found</h5>
                        <p class="text-muted">
                            No active students found in this class.
                        </p>
                    </div>
                </div>
            }
            else
            {
                <form asp-action="SaveAttendance" asp-controller="Attendance"
                      method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="classLevelId" value="@classLevel?.Id" />
                    <input type="hidden" name="classStreamId" value="@ViewBag.ClassStreamId" />
                    <input type="hidden" name="attendanceDate"
                           value="@attendanceDate.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="academicTermId"
                           value="@currentTerm?.Id" />

                    <div class="card">
                        <div class="card-header d-flex justify-content-between
                                    align-items-center">
                            <span>
                                <i class="fas fa-users me-2 text-primary"></i>
                                <strong>@classLevel?.Name Attendance Register</strong>
                                <span class="badge bg-primary ms-2">
                                    @Model.Count students
                                </span>
                            </span>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-success btn-sm"
                                        onclick="markAll(1)">
                                    <i class="fas fa-check-double me-1"></i>
                                    All Present
                                </button>
                                <button type="button" class="btn btn-danger btn-sm"
                                        onclick="markAll(2)">
                                    <i class="fas fa-times me-1"></i>
                                    All Absent
                                </button>
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Adm No.</th>
                                        <th>Student Name</th>
                                        <th class="text-center">
                                            <span class="text-success">Present</span>
                                        </th>
                                        <th class="text-center">
                                            <span class="text-danger">Absent</span>
                                        </th>
                                        <th class="text-center">
                                            <span class="text-warning">Late</span>
                                        </th>
                                        <th class="text-center">
                                            <span class="text-info">Excused</span>
                                        </th>
                                        <th>Excuse Reason</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.Count; i++)
                                    {
                                        var student = Model[i];
                                        var existing = existingAttendance
                                            .FirstOrDefault(a => a.StudentId == student.Id);
                                        var currentStatus = existing?.Status
                                            ?? AttendanceStatus.Present;
                                        <tr id="row_@student.Id">
                                            <td>@(i + 1)</td>
                                            <td>
                                                <span class="badge bg-light text-dark">
                                                    @student.AdmissionNumber
                                                </span>
                                            </td>
                                            <td><strong>@student.FullName</strong></td>
                                            <td style="display:none;">
    <input type="hidden" name="studentIds[@i]" value="@student.Id" />
</td>

                                            @* Present *@
<td class="text-center">
    <input type="radio"
           name="statuses[@i]"
           value="1"
           class="form-check-input status-radio"
           data-student="@student.Id"
           data-status="1"
           @(currentStatus == AttendanceStatus.Present ? "checked" : "")
           onchange="updateRow(@student.Id, 1)" />
</td>

@* Absent *@
<td class="text-center">
    <input type="radio"
           name="statuses[@i]"
           value="2"
           class="form-check-input status-radio"
           data-student="@student.Id"
           data-status="2"
           @(currentStatus == AttendanceStatus.Absent ? "checked" : "")
           onchange="updateRow(@student.Id, 2)" />
</td>

@* Late *@
<td class="text-center">
    <input type="radio"
           name="statuses[@i]"
           value="3"
           class="form-check-input status-radio"
           data-student="@student.Id"
           data-status="3"
           @(currentStatus == AttendanceStatus.Late ? "checked" : "")
           onchange="updateRow(@student.Id, 3)" />
</td>

@* Excused *@
<td class="text-center">
    <input type="radio"
           name="statuses[@i]"
           value="4"
           class="form-check-input status-radio"
           data-student="@student.Id"
           data-status="4"
           @(currentStatus == AttendanceStatus.Excused ? "checked" : "")
           onchange="updateRow(@student.Id, 4)" />
</td>

                                            @* Excuse Reason *@
                                            <td>
                                                <input type="text"
       name="excuseReasons[@i]"
       class="form-control form-control-sm"
       placeholder="Reason..."
       value="@(existing?.ExcuseReason ?? "")"
       id="reason_@student.Id" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="card-footer d-flex justify-content-between
                                    align-items-center">
                            <div class="small text-muted">
                                <span class="text-success fw-bold" id="presentCount">0</span>
                                Present &nbsp;|&nbsp;
                                <span class="text-danger fw-bold" id="absentCount">0</span>
                                Absent &nbsp;|&nbsp;
                                <span class="text-warning fw-bold" id="lateCount">0</span>
                                Late &nbsp;|&nbsp;
                                <span class="text-info fw-bold" id="excusedCount">0</span>
                                Excused
                            </div>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="fas fa-save me-2"></i>Save Attendance
                            </button>
                        </div>
                    </div>
                </form>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    function updateRow(studentId, status) {
        const row = document.getElementById('row_' + studentId);
        row.classList.remove('table-success', 'table-danger',
            'table-warning', 'table-info');
        if (status == 1) row.classList.add('table-success');
        else if (status == 2) row.classList.add('table-danger');
        else if (status == 3) row.classList.add('table-warning');
        else if (status == 4) row.classList.add('table-info');
        updateCounts();
    }

    function markAll(status) {
        document.querySelectorAll('.status-radio').forEach(radio => {
            if (radio.dataset.status == status) {
                radio.checked = true;
                updateRow(radio.dataset.student, status);
            }
        });
        updateCounts();
    }

    function updateCounts() {
        let present = 0, absent = 0, late = 0, excused = 0;
        document.querySelectorAll('.status-radio:checked').forEach(radio => {
            if (radio.value == 1) present++;
            else if (radio.value == 2) absent++;
            else if (radio.value == 3) late++;
            else if (radio.value == 4) excused++;
        });
        document.getElementById('presentCount').textContent = present;
        document.getElementById('absentCount').textContent = absent;
        document.getElementById('lateCount').textContent = late;
        document.getElementById('excusedCount').textContent = excused;
    }

    // Initialize on page load
    document.querySelectorAll('.status-radio:checked').forEach(radio => {
        updateRow(radio.dataset.student, radio.dataset.status);
    });
    updateCounts();
</script>
}