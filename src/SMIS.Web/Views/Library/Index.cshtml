@{
    ViewData["Title"] = "Library";
}

<div class="app-wrapper">
    @await Html.PartialAsync("_Sidebar")
        

    <div class="main-content">
        <header class="top-header">
            <div class="header-left">
                <span class="page-title">
                    <i class="fas fa-book me-2 text-primary"></i>
                    Library Management
                </span>
            </div>
            <div class="header-right">
                <div class="user-avatar ms-2">
                    @(User.Identity?.Name?.Substring(0,1).ToUpper() ?? "A")
                </div>
                <form asp-action="Logout" asp-controller="Account"
                      method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="header-btn" title="Logout">
                        <i class="fas fa-sign-out-alt"></i>
                    </button>
                </form>
            </div>
        </header>

        <div class="content-area">
            @* Summary Cards *@
            <div class="row g-3 mb-4">
                <div class="col-sm-6 col-xl-3">
                    <div class="stat-card">
                        <div class="stat-icon blue">
                            <i class="fas fa-book"></i>
                        </div>
                        <div>
                            <div class="stat-value">@ViewBag.TotalBooks</div>
                            <div class="stat-label">Total Books</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="stat-card">
                        <div class="stat-icon green">
                            <i class="fas fa-check-circle"></i>
                        </div>
                        <div>
                            <div class="stat-value">@ViewBag.AvailableCopies</div>
                            <div class="stat-label">Available Copies</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="stat-card">
                        <div class="stat-icon orange">
                            <i class="fas fa-hand-holding-heart"></i>
                        </div>
                        <div>
                            <div class="stat-value">@ViewBag.IssuedBooks</div>
                            <div class="stat-label">Issued Books</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="stat-card">
                        <div class="stat-icon purple">
                            <i class="fas fa-exclamation-circle"></i>
                        </div>
                        <div>
                            <div class="stat-value">@ViewBag.OverdueBooks</div>
                            <div class="stat-label">Overdue Books</div>
                        </div>
                    </div>
                </div>
            </div>

            @* Quick Actions *@
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <a href="/Library/Books" class="card text-decoration-none">
                        <div class="card-body text-center p-4">
                            <i class="fas fa-book fa-2x text-primary mb-2"></i>
                            <h6 class="fw-bold">Book Catalog</h6>
                            <p class="text-muted small mb-0">
                                Browse and manage books
                            </p>
                        </div>
                    </a>
                </div>
                <div class="col-md-3">
                    <a href="/Library/AddBook" class="card text-decoration-none">
                        <div class="card-body text-center p-4">
                            <i class="fas fa-plus-circle fa-2x text-success mb-2"></i>
                            <h6 class="fw-bold">Add Book</h6>
                            <p class="text-muted small mb-0">
                                Add new book to catalog
                            </p>
                        </div>
                    </a>
                </div>
                <div class="col-md-3">
                    <a href="/Library/Issues" class="card text-decoration-none">
                        <div class="card-body text-center p-4">
                            <i class="fas fa-hand-holding-heart fa-2x text-warning mb-2"></i>
                            <h6 class="fw-bold">Issue / Return</h6>
                            <p class="text-muted small mb-0">
                                Issue or return books
                            </p>
                        </div>
                    </a>
                </div>
                <div class="col-md-3">
                    <a href="/Library/Issues?status=overdue"
                       class="card text-decoration-none">
                        <div class="card-body text-center p-4">
                            <i class="fas fa-exclamation-circle fa-2x text-danger mb-2"></i>
                            <h6 class="fw-bold">Overdue Books</h6>
                            <p class="text-muted small mb-0">
                                View overdue returns
                            </p>
                        </div>
                    </a>
                </div>
            </div>

            @* Recent Issues *@
            <div class="card">
                <div class="card-header d-flex justify-content-between">
                    <span>
                        <i class="fas fa-history me-2 text-primary"></i>
                        <strong>Recent Book Issues</strong>
                    </span>
                    <a href="/Library/Issues" class="btn btn-sm btn-outline-primary">
                        View All
                    </a>
                </div>
                @if (ViewBag.RecentIssues == null ||
                     ((List<SMIS.Domain.Entities.Library.BookIssue>)ViewBag.RecentIssues).Count == 0)
                {
                    <div class="card-body text-center py-4">
                        <p class="text-muted">No books have been issued yet.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Book</th>
                                    <th>Borrower</th>
                                    <th>Issue Date</th>
                                    <th>Due Date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var issue in
                                    (List<SMIS.Domain.Entities.Library.BookIssue>)ViewBag.RecentIssues)
                                {
                                    <tr>
                                        <td>
                                            <strong>@issue.Book.Title</strong>
                                        </td>
                                        <td>
                                            @if (issue.Student != null)
                                            {
                                                <span>@issue.Student.FullName</span>
                                                <small class="text-muted d-block">Student</small>
                                            }
                                            else
                                            {
                                                <span>@issue.StaffName</span>
                                                <small class="text-muted d-block">Staff</small>
                                            }
                                        </td>
                                        <td>@issue.IssueDate.ToString("dd MMM yyyy")</td>
                                        <td>
                                            @if (issue.DueDate < DateTime.Today &&
                                                 issue.Status == SMIS.Domain.Entities.Library.BookIssueStatus.Issued)
                                            {
                                                <span class="text-danger fw-bold">
                                                    @issue.DueDate.ToString("dd MMM yyyy")
                                                </span>
                                            }
                                            else
                                            {
                                                @issue.DueDate.ToString("dd MMM yyyy")
                                            }
                                        </td>
                                        <td>
                                            @switch (issue.Status)
                                            {
                                                case SMIS.Domain.Entities.Library.BookIssueStatus.Issued:
                                                    <span class="badge bg-primary">Issued</span>
                                                    break;
                                                case SMIS.Domain.Entities.Library.BookIssueStatus.Returned:
                                                    <span class="badge bg-success">Returned</span>
                                                    break;
                                                case SMIS.Domain.Entities.Library.BookIssueStatus.Overdue:
                                                    <span class="badge bg-danger">Overdue</span>
                                                    break;
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>