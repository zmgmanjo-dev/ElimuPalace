@model List<SMIS.Domain.Entities.Library.Book>
@using SMIS.Domain.Entities.Library
@{
    ViewData["Title"] = "Book Catalog";
}

<div class="app-wrapper">
    @await Html.PartialAsync("_Sidebar")
        
    <div class="main-content">
        <header class="top-header">
            <div class="header-left">
                <span class="page-title">
                    <i class="fas fa-book me-2 text-primary"></i>
                    Book Catalog
                </span>
            </div>
            <div class="header-right">
                <a href="/Library/AddBook" class="btn btn-primary btn-sm me-2">
                    <i class="fas fa-plus me-1"></i> Add Book
                </a>
                <a href="/Library/Categories"
                   class="btn btn-outline-secondary btn-sm me-2">
                    <i class="fas fa-tags me-1"></i> Categories
                </a>
                <a href="/Library" class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-arrow-left me-1"></i> Back
                </a>
                <div class="user-avatar ms-2">
                    @(User.Identity?.Name?.Substring(0,1).ToUpper() ?? "A")
                </div>
                <form asp-action="Logout" asp-controller="Account"
                      method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="header-btn" title="Logout">
                        <i class="fas fa-sign-out-alt"></i>
                    </button>
                </form>
            </div>
        </header>

        <div class="content-area">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-4">
                    <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close"
                            data-bs-dismiss="alert"></button>
                </div>
            }

            @* Search *@
            <div class="card mb-4">
                <div class="card-body p-3">
                    <div class="row g-2">
                        <div class="col-md-5">
                            <input type="text" id="searchInput"
                                   class="form-control"
                                   placeholder="Search by title, author or ISBN..."
                                   value="@ViewBag.Search"
                                   onkeyup="if(event.key==='Enter') applyFilter()" />
                        </div>
                        <div class="col-md-4">
                            <select id="categorySelect" class="form-control">
                                <option value="">All Categories</option>
                                @foreach (var cat in ViewBag.Categories)
                                {
                                    if (ViewBag.CategoryId != null &&
                                        ViewBag.CategoryId == cat.Id)
                                    {
                                        <option value="@cat.Id" selected>
                                            @cat.Name
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@cat.Id">@cat.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <button class="btn btn-primary w-100"
                                    onclick="applyFilter()">
                                <i class="fas fa-search me-1"></i> Search
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <i class="fas fa-book me-2 text-primary"></i>
                    <strong>Books</strong>
                    <span class="badge bg-primary ms-2">@Model.Count</span>
                </div>
                @if (!Model.Any())
                {
                    <div class="card-body text-center py-5">
                        <i class="fas fa-book fa-3x text-muted mb-3"></i>
                        <h5 class="text-muted">No Books Found</h5>
                        <p class="text-muted">
                            Click <strong>"Add Book"</strong> to add books
                            to the library catalog.
                        </p>
                        <a href="/Library/AddBook" class="btn btn-primary">
                            <i class="fas fa-plus me-1"></i> Add First Book
                        </a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Title</th>
                                    <th>Author</th>
                                    <th>Category</th>
                                    <th>ISBN</th>
                                    <th class="text-center">Total</th>
                                    <th class="text-center">Available</th>
                                    <th>Condition</th>
                                    <th>Location</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var book in Model)
                                {
                                    <tr>
                                        <td>
                                            <strong>@book.Title</strong>
                                            @if (book.Edition != null)
                                            {
                                                <small class="text-muted d-block">
                                                    @book.Edition Ed.
                                                </small>
                                            }
                                        </td>
                                        <td class="text-muted">
                                            @(book.Author ?? "-")
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark">
                                                @book.Category.Name
                                            </span>
                                        </td>
                                        <td class="text-muted small">
                                            @(book.ISBN ?? "-")
                                        </td>
                                        <td class="text-center">
                                            @book.TotalCopies
                                        </td>
                                        <td class="text-center">
                                            @if (book.AvailableCopies > 0)
                                            {
                                                <span class="badge bg-success">
                                                    @book.AvailableCopies
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">0</span>
                                            }
                                        </td>
                                        <td>
                                            @switch (book.Condition)
                                            {
                                                case BookCondition.New:
                                                    <span class="badge bg-primary">New</span>
                                                    break;
                                                case BookCondition.Good:
                                                    <span class="badge bg-success">Good</span>
                                                    break;
                                                case BookCondition.Fair:
                                                    <span class="badge bg-warning text-dark">Fair</span>
                                                    break;
                                                case BookCondition.Poor:
                                                    <span class="badge bg-danger">Poor</span>
                                                    break;
                                                case BookCondition.Damaged:
                                                    <span class="badge bg-secondary">Damaged</span>
                                                    break;
                                            }
                                        </td>
                                        <td class="text-muted small">
                                            @(book.ShelfLocation ?? "-")
                                        </td>
                                        <td>
                                            <a href="/Library/EditBook/@book.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function applyFilter() {
        const search = document.getElementById('searchInput').value;
        const categoryId = document.getElementById('categorySelect').value;
        let url = '/Library/Books?';
        if (search) url += 'search=' + encodeURIComponent(search) + '&';
        if (categoryId) url += 'categoryId=' + categoryId;
        window.location = url;
    }
</script>
}