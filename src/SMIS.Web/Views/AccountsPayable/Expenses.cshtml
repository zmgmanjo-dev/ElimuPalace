@model List<SMIS.Domain.Entities.Accounting.Expense>
@using SMIS.Domain.Entities.Accounting
@{
    ViewData["Title"] = "Expenses";
    var school = ViewBag.School as SMIS.Domain.Entities.School.SchoolProfile;
    ViewBag.ReportTitle = "Expense Report";
}

<div class="app-wrapper">
    @await Html.PartialAsync("_Sidebar")
        
    <div class="main-content">
        <header class="top-header d-print-none">
            <div class="header-left">
                <span class="page-title">
                    <i class="fas fa-receipt me-2 text-primary"></i>
                    Expenses
                </span>
            </div>
            <div class="header-right">
                <button onclick="window.print()"
                        class="btn btn-outline-primary btn-sm me-2">
                    <i class="fas fa-print me-1"></i> Print
                </button>
                <button class="btn btn-primary btn-sm"
                        data-bs-toggle="modal"
                        data-bs-target="#addExpenseModal">
                    <i class="fas fa-plus me-1"></i> Record Expense
                </button>
                <div class="user-avatar ms-2">
                    @(User.Identity?.Name?.Substring(0,1).ToUpper() ?? "A")
                </div>
                <form asp-action="Logout" asp-controller="Account"
                      method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="header-btn" title="Logout">
                        <i class="fas fa-sign-out-alt"></i>
                    </button>
                </form>
            </div>
        </header>

        <div class="content-area">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-4">
                    <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close"
                            data-bs-dismiss="alert"></button>
                </div>
            }

            @await Html.PartialAsync("_PrintHeader")

            @* Filters *@
            <div class="card mb-4 d-print-none">
                <div class="card-body p-3">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label small fw-bold">From</label>
                            <input type="date" id="fromDate"
                                   class="form-control"
                                   value="@((DateTime)ViewBag.FromDate).ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-bold">To</label>
                            <input type="date" id="toDate"
                                   class="form-control"
                                   value="@((DateTime)ViewBag.ToDate).ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-3">
                            <button class="btn btn-primary w-100"
                                    onclick="applyFilter()">
                                <i class="fas fa-search me-1"></i> Filter
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            @* Summary *@
            <div class="row g-3 mb-4">
                <div class="col-sm-4">
                    <div class="stat-card">
                        <div class="stat-icon orange">
                            <i class="fas fa-receipt"></i>
                        </div>
                        <div>
                            <div class="stat-value">@Model.Count</div>
                            <div class="stat-label">Total Expenses</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="stat-card">
                        <div class="stat-icon purple">
                            <i class="fas fa-money-bill-wave"></i>
                        </div>
                        <div>
                            <div class="stat-value">
                                KES @(((decimal)ViewBag.TotalExpenses).ToString("N0"))
                            </div>
                            <div class="stat-label">Total Amount</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <strong>Expense Records</strong>
                    <span class="badge bg-primary ms-2">@Model.Count</span>
                </div>
                @if (!Model.Any())
                {
                    <div class="card-body text-center py-5">
                        <i class="fas fa-receipt fa-3x text-muted mb-3"></i>
                        <h5 class="text-muted">No Expenses Found</h5>
                        <p class="text-muted">
                            Click <strong>"Record Expense"</strong> to add.
                        </p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover table-bordered mb-0">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Exp No.</th>
                                    <th>Date</th>
                                    <th>Account</th>
                                    <th>Description</th>
                                    <th>Payee</th>
                                    <th>Paid From</th>
                                    <th>Receipt</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Count; i++)
                                {
                                    var exp = Model[i];
                                    <tr>
                                        <td>@(i + 1)</td>
                                        <td>
                                            <span class="badge bg-light text-dark">
                                                @exp.ExpenseNumber
                                            </span>
                                        </td>
                                        <td>
                                            @exp.ExpenseDate.ToString("dd MMM yyyy")
                                        </td>
                                        <td class="small">
                                            @exp.ExpenseAccount.Code —
                                            @exp.ExpenseAccount.Name
                                        </td>
                                        <td>@exp.Description</td>
                                        <td class="text-muted small">
                                            @(exp.Payee ?? "-")
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark small">
                                                @exp.PaidFromAccount.Name
                                            </span>
                                        </td>
                                        <td class="text-muted small">
                                            @(exp.ReceiptNumber ?? "-")
                                        </td>
                                        <td class="text-end fw-bold text-danger">
                                            @exp.Amount.ToString("N2")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <td colspan="8" class="fw-bold text-end">
                                        TOTAL:
                                    </td>
                                    <td class="text-end fw-bold text-danger">
                                        KES @Model.Sum(e => e.Amount).ToString("N2")
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@* ADD EXPENSE MODAL *@
<div class="modal fade" id="addExpenseModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-plus me-2"></i>Record Expense
                </h5>
                <button type="button" class="btn-close"
                        data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateExpense"
                  asp-controller="AccountsPayable" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label fw-bold">
                                Date <span class="text-danger">*</span>
                            </label>
                            <input type="date" name="expenseDate"
                                   class="form-control"
                                   value="@DateTime.Today.ToString("yyyy-MM-dd")"
                                   required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">
                                Expense Account <span class="text-danger">*</span>
                            </label>
                            <select name="expenseAccountId"
                                    class="form-control" required>
                                <option value="">-- Select Account --</option>
                                @foreach (var acc in ViewBag.Accounts)
                                {
                                    <option value="@acc.Id">
                                        @acc.Code — @acc.Name
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">
                                Amount (KES) <span class="text-danger">*</span>
                            </label>
                            <input type="number" name="amount"
                                   class="form-control"
                                   placeholder="0.00" min="0.01"
                                   step="0.01" required />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label fw-bold">
                                Description <span class="text-danger">*</span>
                            </label>
                            <input type="text" name="description"
                                   class="form-control"
                                   placeholder="e.g. Purchase of exercise books"
                                   required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Payee</label>
                            <input type="text" name="payee"
                                   class="form-control"
                                   placeholder="e.g. Supplier name" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">
                                Paid From
                            </label>
                            <select name="paidFromAccountId" class="form-control" required>
    <option value="">-- Select Account --</option>
    @foreach (var acc in (List<SMIS.Domain.Entities.Accounting.Account>)ViewBag.CashAccounts)
    {
        <option value="@acc.Id">@acc.Name</option>
    }
</select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">
                                Receipt No.
                            </label>
                            <input type="text" name="receiptNumber"
                                   class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Term</label>
                            <select name="academicTermId"
                                    class="form-control">
                                <option value="">None</option>
                                @foreach (var term in ViewBag.Terms)
                                {
                                    <option value="@term.Id">
                                        @term.AcademicYear.Name - @term.Name
                                    </option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i>Record Expense
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function applyFilter() {
        const from = document.getElementById('fromDate').value;
        const to = document.getElementById('toDate').value;
        window.location = '/AccountsPayable/Expenses?fromDate=' +
            from + '&toDate=' + to;
    }
</script>
}