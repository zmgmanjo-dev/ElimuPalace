@model SMIS.Domain.Entities.School.SchoolProfile
@using SMIS.Domain.Enums
@{
    ViewData["Title"] = "School Information";
}

<div class="app-wrapper">
    @* SIDEBAR *@
    @await Html.PartialAsync("_Sidebar")
        
    @* MAIN CONTENT *@
    <div class="main-content">
        @* TOP HEADER *@
        <header class="top-header">
            <div class="header-left">
                <span class="page-title">
                    <i class="fas fa-school me-2 text-primary"></i>School Information
                </span>
            </div>
            <div class="header-right">
                <div class="user-avatar">
                    @(User.Identity?.Name?.Substring(0,1).ToUpper() ?? "A")
                </div>
                <form asp-action="Logout" asp-controller="Account" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="header-btn" title="Logout">
                        <i class="fas fa-sign-out-alt"></i>
                    </button>
                </form>
            </div>
        </header>

        @* CONTENT *@
        <div class="content-area">

            @* Success Message *@
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                    <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <form asp-action="SchoolInfo" asp-controller="Setup"
                  method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                @* BASIC INFORMATION *@
                <div class="card mb-4">
                    <div class="card-header">
                        <i class="fas fa-info-circle me-2 text-primary"></i>
                        Basic Information
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">School Name <span class="text-danger">*</span></label>
                                <input asp-for="Name" class="form-control"
                                       placeholder="e.g. Nairobi Primary School" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">KEMIS Code <span class="text-danger">*</span></label>
                                <input asp-for="KemisCode" class="form-control"
                                       placeholder="e.g. 123456" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Registration Number</label>
                                <input asp-for="RegistrationNumber" class="form-control"
                                       placeholder="e.g. MoE/2024/001" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">School Motto</label>
                                <input asp-for="Motto" class="form-control"
                                       placeholder="e.g. Excellence Through Knowledge" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">School Level</label>
                                <select asp-for="Level" class="form-control"
                                        asp-items="Html.GetEnumSelectList<SchoolLevel>()">
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">School Category</label>
                                <select asp-for="Category" class="form-control"
                                        asp-items="Html.GetEnumSelectList<SchoolCategory>()">
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">School Type</label>
                                <select asp-for="Type" class="form-control"
                                        asp-items="Html.GetEnumSelectList<SchoolType>()">
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Date Established</label>
                                <input asp-for="EstablishedDate" type="date" class="form-control" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">School Logo</label>
                                <input type="file" name="logoFile" class="form-control"
                                       accept="image/*" />
                                @if (Model?.LogoPath != null)
                                {
                                    <img src="@Model.LogoPath" class="mt-2"
                                         style="height:50px;border-radius:8px;" />
                                }
                            </div>
                        </div>
                    </div>
                </div>

                @* LOCATION *@
                <div class="card mb-4">
                    <div class="card-header">
                        <i class="fas fa-map-marker-alt me-2 text-danger"></i>
                        Location
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">County <span class="text-danger">*</span></label>
                                <input asp-for="County" class="form-control"
                                       placeholder="e.g. Nairobi" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Sub County</label>
                                <input asp-for="SubCounty" class="form-control"
                                       placeholder="e.g. Westlands" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Ward</label>
                                <input asp-for="Ward" class="form-control"
                                       placeholder="e.g. Parklands" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Physical Address</label>
                                <input asp-for="PhysicalAddress" class="form-control"
                                       placeholder="e.g. Off Waiyaki Way, Westlands" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Postal Address</label>
                                <input asp-for="PostalAddress" class="form-control"
                                       placeholder="e.g. P.O. Box 1234-00100, Nairobi" />
                            </div>
                        </div>
                    </div>
                </div>

                @* CONTACTS *@
                <div class="card mb-4">
                    <div class="card-header">
                        <i class="fas fa-phone me-2 text-success"></i>
                        Contacts
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">Phone Number <span class="text-danger">*</span></label>
                                <input asp-for="PhoneNumber" class="form-control"
                                       placeholder="e.g. 0712345678" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Alternative Phone</label>
                                <input asp-for="AlternativePhone" class="form-control"
                                       placeholder="e.g. 0722345678" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Email Address <span class="text-danger">*</span></label>
                                <input asp-for="Email" type="email" class="form-control"
                                       placeholder="e.g. info@school.ac.ke" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Website</label>
                                <input asp-for="Website" class="form-control"
                                       placeholder="e.g. www.school.ac.ke" />
                            </div>
                        </div>
                    </div>
                </div>

                @* ADMINISTRATION *@
                <div class="card mb-4">
                    <div class="card-header">
                        <i class="fas fa-user-tie me-2 text-warning"></i>
                        Administration
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Principal's Name <span class="text-danger">*</span></label>
                                <input asp-for="Principal" class="form-control"
                                       placeholder="e.g. Mr. John Kamau" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Board Chairperson</label>
                                <input asp-for="BoardChairperson" class="form-control"
                                       placeholder="e.g. Mrs. Jane Wanjiku" />
                            </div>
                        </div>
                    </div>
                </div>

                @* THEME *@
                <div class="card mb-4">
                    <div class="card-header">
                        <i class="fas fa-palette me-2 text-purple"></i>
                        Theme Colors
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Primary Color</label>
                                <div class="d-flex gap-2 align-items-center">
                                    <input asp-for="PrimaryColor" type="color"
                                           class="form-control form-control-color" />
                                    <input asp-for="PrimaryColor" class="form-control"
                                           placeholder="#1a56db" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Secondary Color</label>
                                <div class="d-flex gap-2 align-items-center">
                                    <input asp-for="SecondaryColor" type="color"
                                           class="form-control form-control-color" />
                                    <input asp-for="SecondaryColor" class="form-control"
                                           placeholder="#057a55" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @* SAVE BUTTON *@
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-save me-2"></i>Save School Information
                    </button>
                    <a href="/Dashboard" class="btn btn-outline-secondary px-4">
                        <i class="fas fa-times me-2"></i>Cancel
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>