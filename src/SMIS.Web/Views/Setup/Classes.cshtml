@model List<SMIS.Domain.Entities.School.ClassLevel>
@using SMIS.Domain.Enums
@{
    ViewData["Title"] = "Classes & Streams";
}

<div class="app-wrapper">
    @await Html.PartialAsync("_Sidebar")
        
    <div class="main-content">
        <header class="top-header">
            <div class="header-left">
                <span class="page-title">
                    <i class="fas fa-layer-group me-2 text-primary"></i>Classes & Streams
                </span>
            </div>
            <div class="header-right">
                @if (!Model.Any())
                {
                    <form asp-action="SeedDefaultClasses" asp-controller="Setup"
                          method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success btn-sm me-2">
                            <i class="fas fa-magic me-1"></i> Load CBC Classes
                        </button>
                    </form>
                }
                <button class="btn btn-primary btn-sm"
                        data-bs-toggle="modal" data-bs-target="#addClassModal">
                    <i class="fas fa-plus me-1"></i> Add Class
                </button>
                <div class="user-avatar ms-2">
                    @(User.Identity?.Name?.Substring(0,1).ToUpper() ?? "A")
                </div>
                <form asp-action="Logout" asp-controller="Account" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="header-btn" title="Logout">
                        <i class="fas fa-sign-out-alt"></i>
                    </button>
                </form>
            </div>
        </header>

        <div class="content-area">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-4">
                    <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mb-4">
                    <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (!Model.Any())
            {
                <div class="card">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-layer-group fa-3x text-muted mb-3"></i>
                        <h5 class="text-muted">No Classes Yet</h5>
                        <p class="text-muted">
                            Click <strong>"Load CBC Classes"</strong> to automatically
                            create all CBC classes (PP1, PP2, Grade 1-9),
                            or click <strong>"Add Class"</strong> to add manually.
                        </p>
                    </div>
                </div>
            }
            else
            {
                @* Group classes by level *@
                var grouped = Model.GroupBy(c => c.Level).OrderBy(g => g.Key);
                @foreach (var group in grouped)
                {
                    <div class="card mb-4">
                        <div class="card-header">
                            <i class="fas fa-layer-group me-2 text-primary"></i>
                            <strong>
                                @switch (group.Key)
                                {
                                    case SchoolLevel.PrePrimary:
                                        @:Pre-Primary
                                        break;
                                    case SchoolLevel.LowerPrimary:
                                        @:Lower Primary (Grade 1-3)
                                        break;
                                    case SchoolLevel.UpperPrimary:
                                        @:Upper Primary (Grade 4-6)
                                        break;
                                    case SchoolLevel.JuniorSchool:
                                        @:Junior School (Grade 7-9)
                                        break;
                                    case SchoolLevel.SeniorSchool:
                                        @:Senior School (Grade 10-12)
                                        break;
                                }
                            </strong>
                            <span class="badge bg-primary ms-2">
                                @group.Count() classes
                            </span>
                        </div>
                        <div class="card-body p-0">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Class Name</th>
                                        <th>Short Name</th>
                                        <th>Streams</th>
                                        <th>Add Stream</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var cls in group.OrderBy(c => c.OrderIndex))
                                    {
                                        <tr>
                                            <td>
                                                <i class="fas fa-door-open text-primary me-2"></i>
                                                <strong>@cls.Name</strong>
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-dark">
                                                    @cls.ShortName
                                                </span>
                                            </td>
                                            <td>
                                                @if (cls.Streams.Any())
                                                {
                                                    @foreach (var stream in cls.Streams)
                                                    {
                                                        <span class="badge bg-info text-dark me-1">
                                                            @stream.Name
                                                            <form asp-action="DeleteStream"
                                                                  asp-controller="Setup"
                                                                  method="post" class="d-inline">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="id"
                                                                       value="@stream.Id" />
                                                                <button type="submit"
                                                                        class="btn-close btn-close-white ms-1"
                                                                        style="font-size:8px;"
                                                                        title="Remove stream"
                                                                        onclick="return confirm('Remove this stream?')">
                                                                </button>
                                                            </form>
                                                        </span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">No streams</span>
                                                }
                                            </td>
                                            <td>
                                                <button class="btn btn-outline-primary btn-sm"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#addStreamModal"
                                                        data-class-id="@cls.Id"
                                                        data-class-name="@cls.Name">
                                                    <i class="fas fa-plus"></i> Stream
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

@* ADD CLASS MODAL *@
<div class="modal fade" id="addClassModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-plus me-2"></i>Add Class
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateClass" asp-controller="Setup" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Class Name <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control"
                               placeholder="e.g. Grade 1" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Short Name <span class="text-danger">*</span></label>
                        <input type="text" name="shortName" class="form-control"
                               placeholder="e.g. G1" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">School Level <span class="text-danger">*</span></label>
                        <select name="level" class="form-control"
                                asp-items="Html.GetEnumSelectList<SchoolLevel>()">
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Order Index</label>
                        <input type="number" name="orderIndex" class="form-control"
                               placeholder="e.g. 1" value="1" />
                        <small class="text-muted">Used for sorting (1 = first)</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i>Create Class
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ADD STREAM MODAL *@
<div class="modal fade" id="addStreamModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-plus me-2"></i>Add Stream
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateStream" asp-controller="Setup" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="classLevelId" id="streamClassId" />
                <div class="modal-body">
                    <p class="text-muted mb-3">
                        Adding stream to: <strong id="streamClassName"></strong>
                    </p>
                    <div class="mb-3">
                        <label class="form-label">Stream Name <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control"
                               placeholder="e.g. East, West, North, South, A, B" required />
                        <small class="text-muted">
                            Common names: East, West, North, South, A, B, C, Red, Blue
                        </small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i>Add Stream
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.querySelectorAll('[data-bs-target="#addStreamModal"]').forEach(btn => {
        btn.addEventListener('click', function() {
            document.getElementById('streamClassId').value = this.dataset.classId;
            document.getElementById('streamClassName').textContent = this.dataset.className;
        });
    });
</script>
}